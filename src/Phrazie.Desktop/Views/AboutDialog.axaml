<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Phrazie.Desktop.Views.AboutDialog"
        Title="About Phrazie"
        Width="420"
        Height="320"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource MainBackgroundBrush}"
        Icon="/Assets/icon.png"
        WindowDecorations="None">

    <Border Background="{StaticResource PanelBackgroundBrush}"
            BorderBrush="{StaticResource BoxBorderDefault}"
            BorderThickness="1"
            CornerRadius="12"
            Margin="1">

        <Panel>

            <StackPanel Spacing="20" Margin="36,32,36,32">

                <StackPanel Spacing="6">
                    <TextBlock Text="PHRAZIE"
                               Foreground="{StaticResource TextBrushDisabled}"
                               FontSize="11"
                               LetterSpacing="4" />
                    <TextBlock Text="Visual performance toolkit"
                               Foreground="{StaticResource TextBrushPrimary}"
                               FontSize="22"
                               FontWeight="Light" />
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="Version 0.1.0 — Early Preview"
                               Foreground="{StaticResource TextBrushSecondary}"
                               FontSize="13" />
                    <TextBlock Text="Built with .NET 9 · Avalonia 12 · LibVLC · Supabase"
                               Foreground="{StaticResource TextBrushDisabled}"
                               FontSize="12" />
                </StackPanel>

                <Border Height="1" Background="{StaticResource BoxBorderDefault}" />

                <StackPanel Spacing="4">
                    <TextBlock Text="© 2026 Sean Liu. All rights reserved."
                               Foreground="{StaticResource TextBrushDisabled}"
                               FontSize="12" />
                    <TextBlock Text="Video decoding powered by VideoLAN / LibVLC."
                               Foreground="{StaticResource TextBrushDisabled}"
                               FontSize="11" />
                </StackPanel>

            </StackPanel>

            <Button Click="OnCloseClick"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,10,10,0"
                    Background="Transparent"
                    Foreground="{StaticResource TextBrushDisabled}"
                    BorderThickness="0"
                    Width="28" Height="28"
                    FontSize="13"
                    Padding="0"
                    CornerRadius="4"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    ToolTip.Tip="Close">&#x2715;</Button>

        </Panel>
    </Border>

</Window>
