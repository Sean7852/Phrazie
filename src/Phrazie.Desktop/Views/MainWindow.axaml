<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Phrazie.Desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
        x:Class="Phrazie.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Background="{StaticResource MainBackgroundBrush}"
        Title="Phrazie"
        Icon="/Assets/icon.png"
        xmlns:views="using:Phrazie.Desktop.Views"
        WindowDecorations="None">

    <Grid RowDefinitions="36,*">

    <!-- ── Custom title bar ───────────────────────────────────────────────── -->
    <Grid Grid.Row="0"
          Background="{StaticResource PanelBackgroundBrush}"
          chrome:WindowDecorationProperties.ElementRole="TitleBar"
          PointerPressed="TitleBar_PointerPressed"
          DoubleTapped="TitleBar_DoubleTapped">
        <TextBlock Text="PHRAZIE"
                   Foreground="{StaticResource TextBrushDisabled}"
                   FontSize="11"
                   LetterSpacing="3"
                   VerticalAlignment="Center"
                   Margin="20,0,0,0"
                   IsHitTestVisible="False" />
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Stretch">
            <Button x:Name="MinBtn"
                    Classes="titlebar-btn"
                    Click="MinBtn_Click"
                    chrome:WindowDecorationProperties.ElementRole="MinimizeButton">&#x2014;</Button>
            <Button x:Name="MaxBtn"
                    Classes="titlebar-btn"
                    Click="MaxBtn_Click"
                    chrome:WindowDecorationProperties.ElementRole="MaximizeButton">&#x25A1;</Button>
            <Button x:Name="CloseBtn"
                    Classes="titlebar-btn close"
                    Click="CloseBtn_Click"
                    chrome:WindowDecorationProperties.ElementRole="CloseButton">&#x2715;</Button>
        </StackPanel>
    </Grid>

    <!-- ── App body ───────────────────────────────────────────────────────── -->
    <Panel Grid.Row="1">

    <!-- ── Login overlay ─────────────────────────────────────────────────── -->
    <Panel IsVisible="{Binding !IsAuthenticated}">
        <views:LoginView DataContext="{Binding LoginPage}" />
    </Panel>

    <!-- ── Main app ──────────────────────────────────────────────────────── -->
    <Grid ColumnDefinitions="180,*"
          IsVisible="{Binding IsAuthenticated}">

        <!-- ── Sidebar ── -->
        <Border Grid.Column="0"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource BoxBorderDefault}"
                BorderThickness="0,0,1,0">
            <Grid RowDefinitions="Auto,*,Auto">

                <StackPanel Grid.Row="0" Margin="0,16,0,0" Spacing="2">
                    <Button Command="{Binding GoToCollectionsCommand}"
                            Classes="nav"
                            Classes.active="{Binding IsCollectionsActive}"
                            ToolTip.Tip="Browse and manage your visual collections">
                        Collections
                    </Button>
                    <Button Command="{Binding GoToLiveCommand}"
                            Classes="nav"
                            Classes.active="{Binding IsLiveActive}"
                            ToolTip.Tip="Open the live performance screen">
                        Live
                    </Button>
                    <Button Command="{Binding GoToClipQueueCommand}"
                            Classes="nav"
                            Classes.active="{Binding IsClipQueueActive}"
                            ToolTip.Tip="View and manage the clip queue">
                        Queue
                    </Button>
                </StackPanel>

                <StackPanel Grid.Row="2" Spacing="0" Margin="0,0,0,8">
                    <Button Command="{Binding GoToSettingsCommand}"
                            Classes="nav"
                            Classes.active="{Binding IsSettingsActive}"
                            ToolTip.Tip="App settings and preferences">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="⚙"
                                       Foreground="{StaticResource TextBrushSecondary}"
                                       FontSize="14"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="Settings" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding GoToHelpCommand}"
                            Classes="nav"
                            Classes.active="{Binding IsHelpActive}"
                            ToolTip.Tip="Help, tips, and resources">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Width="20" Height="20"
                                    CornerRadius="10"
                                    BorderBrush="{StaticResource BoxBorderDefault}"
                                    BorderThickness="1"
                                    VerticalAlignment="Center">
                                <TextBlock Text="?"
                                           Foreground="{StaticResource TextBrushSecondary}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Help &amp; Resources" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

            </Grid>
        </Border>

        <!-- ── Content area ── -->
        <Border Grid.Column="1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="{StaticResource SurfaceBlack}" Offset="0" />
                    <GradientStop Color="#0D1535" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <ContentControl Content="{Binding CurrentPage}" />
        </Border>

    </Grid>

    <!-- ── Clip browser modal overlay ─────────────────────────────────────── -->
    <Panel IsVisible="{Binding ActiveBrowser, Converter={x:Static ObjectConverters.IsNotNull}}">
        <views:ClipBrowserView DataContext="{Binding ActiveBrowser}" />
    </Panel>

    </Panel>

    </Grid>

    <Window.Styles>
        <Style Selector="Button.nav">
            <Setter Property="Background"                 Value="Transparent" />
            <Setter Property="Foreground"                 Value="{StaticResource TextBrushSecondary}" />
            <Setter Property="BorderThickness"            Value="0" />
            <Setter Property="Padding"                    Value="20,10" />
            <Setter Property="HorizontalAlignment"        Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="CornerRadius"               Value="0" />
        </Style>
        <Style Selector="Button.nav:pointerover /template/ ContentPresenter">
            <Setter Property="Background"             Value="{StaticResource ControlBackgroundBrush}" />
            <Setter Property="TextElement.Foreground" Value="{StaticResource TextBrushPrimary}" />
        </Style>
        <Style Selector="Button.nav.active /template/ ContentPresenter">
            <Setter Property="Background"             Value="{StaticResource ControlBackgroundBrush}" />
            <Setter Property="TextElement.Foreground" Value="{StaticResource TextBrushPrimary}" />
        </Style>

        <Style Selector="Button.titlebar-btn">
            <Setter Property="Background"                 Value="Transparent" />
            <Setter Property="Foreground"                 Value="{StaticResource TextBrushSecondary}" />
            <Setter Property="BorderThickness"            Value="0" />
            <Setter Property="Width"                      Value="46" />
            <Setter Property="Height"                     Value="36" />
            <Setter Property="FontSize"                   Value="14" />
            <Setter Property="Padding"                    Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment"   Value="Center" />
            <Setter Property="CornerRadius"               Value="0" />
        </Style>
        <Style Selector="Button.titlebar-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background"             Value="{StaticResource BoxBorderDefault}" />
            <Setter Property="TextElement.Foreground" Value="{StaticResource TextBrushPrimary}" />
        </Style>
        <Style Selector="Button.titlebar-btn.close:pointerover /template/ ContentPresenter">
            <Setter Property="Background"             Value="#C42B1C" />
            <Setter Property="TextElement.Foreground" Value="{StaticResource TextBrushPrimary}" />
        </Style>
    </Window.Styles>

</Window>
