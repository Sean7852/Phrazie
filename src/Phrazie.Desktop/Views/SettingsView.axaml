<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Phrazie.Desktop.ViewModels"
             x:Class="Phrazie.Desktop.Views.SettingsView"
             x:DataType="vm:SettingsViewModel"
             Background="Transparent">

    <Grid ColumnDefinitions="220,1,*">

        <Border Grid.Column="0" Background="{StaticResource PanelBackgroundBrush}">
            <DockPanel>

                <StackPanel DockPanel.Dock="Top" Margin="20,28,20,16" Spacing="4">
                    <TextBlock Text="Settings"
                               Foreground="{StaticResource TextBrushPrimary}"
                               FontSize="18"
                               FontWeight="Light" />
                    <TextBlock Text="App preferences"
                               Foreground="{StaticResource TextBrushDisabled}"
                               FontSize="11" />
                </StackPanel>

                <ListBox ItemsSource="{Binding Sections}"
                         SelectedItem="{Binding SelectedSection}"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0">
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Background"   Value="Transparent" />
                            <Setter Property="Padding"      Value="20,12,16,12" />
                            <Setter Property="Margin"       Value="0" />
                            <Setter Property="CornerRadius" Value="0" />
                        </Style>
                        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                            <Setter Property="Background" Value="{StaticResource ControlBackgroundBrush}" />
                        </Style>
                        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                            <Setter Property="Background" Value="{StaticResource ControlBackgroundBrush}" />
                        </Style>
                        <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter">
                            <Setter Property="Background" Value="{StaticResource ControlBackgroundBrush}" />
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:SettingsSectionViewModel">
                            <Grid ColumnDefinitions="28,*">
                                <TextBlock Grid.Column="0"
                                           Text="{Binding SectionIcon}"
                                           Foreground="{StaticResource TextBrushSecondary}"
                                           FontSize="14"
                                           VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SectionName}"
                                               Foreground="{StaticResource TextBrushPrimary}"
                                               FontSize="13"
                                               FontWeight="Medium" />
                                    <TextBlock Text="{Binding SectionDescription}"
                                               Foreground="{StaticResource TextBrushDisabled}"
                                               FontSize="11"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

            </DockPanel>
        </Border>

        <Border Grid.Column="1" Background="{StaticResource BoxBorderDefault}" />

        <ContentControl Grid.Column="2" Content="{Binding SelectedSection}" />

    </Grid>

</UserControl>
