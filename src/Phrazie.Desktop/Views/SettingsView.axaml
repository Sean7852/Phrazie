<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Phrazie.Desktop.ViewModels"
             x:Class="Phrazie.Desktop.Views.SettingsView"
             x:DataType="vm:SettingsViewModel"
             Background="Transparent">

    <Grid ColumnDefinitions="220,1,*">

        <!-- ── Master menu ── -->
        <Border Grid.Column="0" Background="#0C0C18">
            <DockPanel>

                <!-- Panel title -->
                <StackPanel DockPanel.Dock="Top" Margin="20,28,20,16" Spacing="4">
                    <TextBlock Text="Settings"
                               Foreground="White"
                               FontSize="18"
                               FontWeight="Light" />
                    <TextBlock Text="App preferences"
                               Foreground="#444466"
                               FontSize="11" />
                </StackPanel>

                <!-- Section list -->
                <ListBox ItemsSource="{Binding Sections}"
                         SelectedItem="{Binding SelectedSection}"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0">
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Background"   Value="Transparent" />
                            <Setter Property="Padding"      Value="20,12,16,12" />
                            <Setter Property="Margin"       Value="0" />
                            <Setter Property="CornerRadius" Value="0" />
                        </Style>
                        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                            <Setter Property="Background" Value="#16162A" />
                        </Style>
                        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                            <Setter Property="Background" Value="#1C1C32" />
                        </Style>
                        <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter">
                            <Setter Property="Background" Value="#20203A" />
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:SettingsSectionViewModel">
                            <Grid ColumnDefinitions="28,*">
                                <TextBlock Grid.Column="0"
                                           Text="{Binding SectionIcon}"
                                           Foreground="#666688"
                                           FontSize="14"
                                           VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SectionName}"
                                               Foreground="White"
                                               FontSize="13"
                                               FontWeight="Medium" />
                                    <TextBlock Text="{Binding SectionDescription}"
                                               Foreground="#555566"
                                               FontSize="11"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

            </DockPanel>
        </Border>

        <!-- ── Divider ── -->
        <Border Grid.Column="1" Background="#1E1E30" />

        <!-- ── Detail panel ── -->
        <ContentControl Grid.Column="2" Content="{Binding SelectedSection}" />

    </Grid>

</UserControl>
