<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Phrazie.Desktop.ViewModels"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        xmlns:conv="using:Phrazie.Desktop.Converters"
        x:Class="Phrazie.Desktop.Views.ClipManagerWindow"
        x:DataType="vm:ClipManagerViewModel"
        Title="{Binding StateName, StringFormat='Clips — {0}'}"
        Width="760" Height="560"
        MinWidth="520" MinHeight="380"
        Background="{StaticResource MainBackgroundBrush}"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        WindowDecorations="None"
        RequestedThemeVariant="Dark">

    <Window.Resources>
        <conv:HexToBrushConverter x:Key="HexToBrush" />
        <SolidColorBrush x:Key="MenuFlyoutPresenterBackground"       Color="{StaticResource SurfaceLight}" />
        <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush"      Color="{StaticResource BorderMuted}" />
        <SolidColorBrush x:Key="MenuFlyoutItemBackground"            Color="Transparent" />
        <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPointerOver" Color="{StaticResource BorderMuted}" />
        <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPressed"     Color="{StaticResource SurfaceLight}" />
        <SolidColorBrush x:Key="MenuFlyoutItemForeground"            Color="{StaticResource TextEnabled}" />
        <SolidColorBrush x:Key="MenuFlyoutItemForegroundPointerOver" Color="{StaticResource TextEnabled}" />
        <SolidColorBrush x:Key="MenuFlyoutItemForegroundPressed"     Color="{StaticResource TextEnabled}" />
        <SolidColorBrush x:Key="MenuFlyoutSeparatorThemeBrush"       Color="{StaticResource BorderMuted}" />
    </Window.Resources>

    <Window.Styles>
        <Style Selector="ContextMenu">
            <Setter Property="Background"      Value="{StaticResource ControlBackgroundBrush}" />
            <Setter Property="BorderBrush"     Value="{StaticResource BoxBorderDefault}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding"         Value="4" />
            <Setter Property="CornerRadius"    Value="6" />
        </Style>
        <Style Selector="MenuItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrushPrimary}" />
            <Setter Property="FontSize"   Value="13" />
            <Setter Property="Padding"    Value="10,7" />
            <Setter Property="MinHeight"  Value="32" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="MenuItem:pointerover /template/ Border#PART_LayoutRoot">
            <Setter Property="Background"   Value="{StaticResource BoxBorderDefault}" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style Selector="MenuItem:pointerover > ContentPresenter">
            <Setter Property="TextElement.Foreground" Value="{StaticResource TextBrushPrimary}" />
        </Style>
        <Style Selector="MenuItem:pressed /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="{StaticResource ControlBackgroundBrush}" />
        </Style>
        <Style Selector="Separator">
            <Setter Property="Background" Value="{StaticResource BoxBorderDefault}" />
            <Setter Property="Margin"     Value="6,3" />
        </Style>
    </Window.Styles>

    <Panel>

    <Border Background="{StaticResource PanelBackgroundBrush}"
            BorderBrush="{StaticResource BoxBorderDefault}"
            BorderThickness="1"
            CornerRadius="12"
            Margin="1">

        <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">

            <Grid Grid.Row="0"
                  x:Name="HeaderDragArea"
                  chrome:WindowDecorationProperties.ElementRole="TitleBar"
                  PointerPressed="Header_PointerPressed">
                <StackPanel Margin="32,28,80,20" Spacing="4">
                    <Button Command="{Binding OpenEditCommand}"
                            Background="Transparent" BorderThickness="0" Padding="0"
                            Cursor="Hand" HorizontalAlignment="Left"
                            ToolTip.Tip="Click to edit state name and color">
                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <Border Width="16" Height="16"
                                    CornerRadius="4"
                                    Background="{Binding StateColor, Converter={StaticResource HexToBrush}}"
                                    VerticalAlignment="Center" />
                            <TextBlock Text="{Binding StateName}"
                                       Foreground="{StaticResource TextBrushPrimary}"
                                       FontSize="24"
                                       FontWeight="Light" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="Drag &amp; drop to add · drag to select · right-click for options"
                               Foreground="{StaticResource TextBrushDisabled}"
                               FontSize="12"
                               Margin="0,2,0,0" />
                </StackPanel>

                <Button x:Name="HeaderCloseBtn"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,10,10,0"
                        Background="Transparent"
                        Foreground="{StaticResource TextBrushDisabled}"
                        BorderThickness="0"
                        Width="28" Height="28"
                        FontSize="13"
                        Padding="0"
                        CornerRadius="4"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        chrome:WindowDecorationProperties.ElementRole="CloseButton"
                        ToolTip.Tip="Close">&#x2715;</Button>
            </Grid>

            <Border Grid.Row="1" Height="1" Background="{StaticResource BoxBorderDefault}" Margin="32,0" />

            <ScrollViewer Grid.Row="2"
                          Margin="32,20,32,0"
                          DragDrop.AllowDrop="True"
                          x:Name="DropTarget">

                <Grid x:Name="ClipCanvas" Background="Transparent">

                    <Grid.ContextMenu>
                        <ContextMenu x:Name="SelectionMenu" Opening="SelectionMenu_Opening">
                            <MenuItem x:Name="DeleteSelectionItem" Header="Delete" />
                        </ContextMenu>
                    </Grid.ContextMenu>

                    <ItemsControl ItemsSource="{Binding Clips}" Background="Transparent">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ManagedClipViewModel">
                                <Border Width="148" Height="120"
                                        Margin="0,0,12,12"
                                        CornerRadius="8"
                                        ClipToBounds="True"
                                        Background="{StaticResource ControlBackgroundBrush}"
                                        BorderBrush="{StaticResource BoxBorderDefault}"
                                        BorderThickness="1"
                                        Cursor="Hand">
                                    <Panel>
                                        <Image Source="{Binding Thumbnail}"
                                               Stretch="UniformToFill"
                                               IsVisible="{Binding Thumbnail, Converter={x:Static ObjectConverters.IsNotNull}}" />

                                        <StackPanel VerticalAlignment="Center"
                                                    HorizontalAlignment="Center"
                                                    Spacing="4"
                                                    IsVisible="{Binding Thumbnail, Converter={x:Static ObjectConverters.IsNull}}">
                                            <TextBlock Text="▶"
                                                       Foreground="{StaticResource TextBrushDisabled}"
                                                       FontSize="22"
                                                       HorizontalAlignment="Center" />
                                        </StackPanel>

                                        <Border Background="#CC000000"
                                                IsVisible="{Binding !IsEnabled}">
                                            <TextBlock Text="DISABLED"
                                                       Foreground="{StaticResource TextBrushDisabled}"
                                                       FontSize="10"
                                                       LetterSpacing="1"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>

                                        <Border VerticalAlignment="Bottom"
                                                Background="#E60A0A16"
                                                Padding="8,5">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       Foreground="{StaticResource TextBrushSecondary}"
                                                       FontSize="10"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Border>

                                        <Border IsVisible="{Binding IsSelected}"
                                                BorderBrush="#4499FF"
                                                BorderThickness="2"
                                                CornerRadius="8"
                                                Background="#1A2244AA" />
                                    </Panel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Canvas IsHitTestVisible="False">
                        <Border x:Name="MarqueeRect"
                                IsVisible="False"
                                BorderBrush="#4488CC"
                                BorderThickness="1"
                                Background="#10203866"
                                CornerRadius="2" />
                    </Canvas>

                </Grid>
            </ScrollViewer>

            <Border Grid.Row="3" Height="1" Background="{StaticResource BoxBorderDefault}" Margin="32,16,32,0" />

            <Grid Grid.Row="4" Margin="32,14,32,24" ColumnDefinitions="*,Auto">

                <TextBlock Grid.Column="0"
                           Text="{Binding Clips.Count, StringFormat='{}{0} clip(s)'}"
                           Foreground="{StaticResource TextBrushSecondary}"
                           FontSize="12"
                           VerticalAlignment="Center" />

                <Button Grid.Column="1"
                        x:Name="DoneButton"
                        Content="Done"
                        Background="{StaticResource ControlBackgroundBrush}"
                        Foreground="{StaticResource TextBrushPrimary}"
                        BorderBrush="{StaticResource BoxBorderDefault}"
                        BorderThickness="1"
                        Padding="24,8"
                        CornerRadius="6"
                        FontSize="13"
                        ToolTip.Tip="Close this window" />

            </Grid>

        </Grid>
    </Border>

    <!-- State edit modal overlay -->
    <Border IsVisible="{Binding IsStateEditOpen}" Background="#B3000000">
        <Border Background="{StaticResource ControlBackgroundBrush}"
                BorderBrush="{StaticResource BoxBorderDefault}"
                BorderThickness="1"
                CornerRadius="12"
                Width="400"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Padding="28,24">
            <StackPanel Spacing="20">

                <TextBlock Text="Edit State"
                           Foreground="{StaticResource TextBrushPrimary}" FontSize="18" FontWeight="Light" />

                <StackPanel Spacing="6">
                    <TextBlock Text="Name" Foreground="{StaticResource TextBrushSecondary}" FontSize="12" />
                    <TextBox Text="{Binding StateEditName}"
                             Background="{StaticResource ControlBackgroundBrush}"
                             BorderBrush="{StaticResource BoxBorderDefault}"
                             CornerRadius="6" FontSize="14" Padding="12,8"
                             ToolTip.Tip="State name" />
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Text="Color" Foreground="{StaticResource TextBrushSecondary}" FontSize="12" />
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Border Width="28" Height="28" CornerRadius="6"
                                Background="{Binding StateEditColor, Converter={StaticResource HexToBrush}}" />
                        <TextBlock Text="{Binding StateEditColor}"
                                   Foreground="{StaticResource TextBrushDisabled}" FontSize="12"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <ListBox ItemsSource="{x:Static vm:ClipManagerViewModel.PresetColors}"
                             SelectedItem="{Binding StateEditColor}"
                             Background="Transparent" BorderThickness="0" Padding="0">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="4" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="CornerRadius" Value="20" />
                            </Style>
                            <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                <Setter Property="Background" Value="Transparent" />
                            </Style>
                            <Style Selector="ListBoxItem:selected > Border">
                                <Setter Property="BorderBrush" Value="{StaticResource TextBrushPrimary}" />
                                <Setter Property="BorderThickness" Value="2" />
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Border Width="32" Height="32" CornerRadius="16"
                                        Background="{Binding Converter={StaticResource HexToBrush}}"
                                        Cursor="Hand" ToolTip.Tip="{Binding}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Command="{Binding SaveStateEditCommand}"
                            Content="Save"
                            Background="#1E3A5F" Foreground="{StaticResource TextBrushPrimary}"
                            BorderThickness="0" Padding="20,9" CornerRadius="6" FontSize="13"
                            ToolTip.Tip="Save state changes" />
                    <Button Command="{Binding CancelStateEditCommand}"
                            Content="Cancel"
                            Background="Transparent" Foreground="{StaticResource TextBrushDisabled}"
                            BorderThickness="0" Padding="14,9" FontSize="13"
                            ToolTip.Tip="Discard changes" />
                </StackPanel>

            </StackPanel>
        </Border>
    </Border>

    </Panel>

</Window>
