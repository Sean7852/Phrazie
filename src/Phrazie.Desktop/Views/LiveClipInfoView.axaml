<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Phrazie.Desktop.Views.LiveClipInfoView"
             Background="Transparent">

    <Panel>
        <StackPanel VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Spacing="12">
            <TextBlock Text="&#x266A;"
                       FontSize="42"
                       Foreground="{StaticResource BoxBorderDefault}"
                       HorizontalAlignment="Center" />
            <TextBlock Text="CLIP INFO"
                       Foreground="{StaticResource BoxBorderDefault}"
                       FontSize="10"
                       LetterSpacing="3"
                       HorizontalAlignment="Center" />
        </StackPanel>
    </Panel>

</UserControl>
