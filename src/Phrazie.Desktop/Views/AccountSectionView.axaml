<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Phrazie.Desktop.ViewModels"
             x:Class="Phrazie.Desktop.Views.AccountSectionView"
             x:DataType="vm:AccountSectionViewModel"
             Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,32" Spacing="28" MaxWidth="560">

            <!-- Section heading -->
            <StackPanel Spacing="4">
                <TextBlock Text="Account"
                           Foreground="White"
                           FontSize="20"
                           FontWeight="Light" />
                <TextBlock Text="Manage your session and app info."
                           Foreground="#444466"
                           FontSize="12" />
            </StackPanel>

            <!-- Signed-in card -->
            <Border Background="#0E0E1A"
                    BorderBrush="#1E1E30"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20,16">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="SIGNED IN AS"
                                   Foreground="#444466"
                                   FontSize="10"
                                   LetterSpacing="2" />
                        <TextBlock Text="{Binding UserEmail}"
                                   Foreground="White"
                                   FontSize="15"
                                   FontWeight="Medium" />
                    </StackPanel>

                    <Button Command="{Binding SignOutCommand}"
                            HorizontalAlignment="Left"
                            Background="#1A0E0E"
                            Foreground="#CC6655"
                            BorderBrush="#3A1E1E"
                            BorderThickness="1"
                            Padding="18,8"
                            CornerRadius="6"
                            FontSize="13">
                        Sign out
                    </Button>
                </StackPanel>
            </Border>

            <!-- About card -->
            <Border Background="#0E0E1A"
                    BorderBrush="#1E1E30"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20,16">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="ABOUT"
                                   Foreground="#444466"
                                   FontSize="10"
                                   LetterSpacing="2" />
                        <TextBlock Text="Phrazie — version info, credits, and licenses."
                                   Foreground="#888899"
                                   FontSize="12" />
                    </StackPanel>

                    <Button Command="{Binding ShowAboutCommand}"
                            HorizontalAlignment="Left"
                            Background="#12121E"
                            Foreground="#AAAACC"
                            BorderBrush="#2A2A44"
                            BorderThickness="1"
                            Padding="18,8"
                            CornerRadius="6"
                            FontSize="13">
                        About Phrazie
                    </Button>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>

</UserControl>
