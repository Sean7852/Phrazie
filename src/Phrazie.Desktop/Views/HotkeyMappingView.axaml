<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Phrazie.Desktop.ViewModels"
             x:Class="Phrazie.Desktop.Views.HotkeyMappingView"
             x:DataType="vm:HotkeyMappingViewModel"
             Background="Transparent">

    <ScrollViewer Padding="36,28,36,36">
        <StackPanel Spacing="24" MaxWidth="680">

            <StackPanel Spacing="6">
                <TextBlock Text="Hotkey Mapping"
                           Foreground="{StaticResource TextBrushPrimary}"
                           FontSize="22"
                           FontWeight="Light" />
                <TextBlock Text="Assign keyboard shortcuts to live performance controls. Click Change next to any action, then press the key you want to use."
                           Foreground="{StaticResource TextBrushSecondary}"
                           FontSize="13"
                           TextWrapping="Wrap" />
            </StackPanel>

            <Border Background="{StaticResource ControlBackgroundBrush}"
                    BorderBrush="{StaticResource BoxBorderDefault}"
                    BorderThickness="1"
                    CornerRadius="8">
                <StackPanel>

                    <Grid ColumnDefinitions="*,120,80" Margin="20,14,20,10">
                        <Grid.Styles>
                            <Style Selector="TextBlock.th">
                                <Setter Property="Foreground"    Value="{StaticResource TextBrushDisabled}" />
                                <Setter Property="FontSize"      Value="10" />
                                <Setter Property="LetterSpacing" Value="2" />
                                <Setter Property="FontWeight"    Value="Medium" />
                            </Style>
                        </Grid.Styles>
                        <TextBlock Grid.Column="0" Classes="th" Text="ACTION" />
                        <TextBlock Grid.Column="1" Classes="th" Text="KEY" />
                        <TextBlock Grid.Column="2" Classes="th" Text="" />
                    </Grid>

                    <Border Height="1" Background="{StaticResource BoxBorderDefault}" Margin="0,0,0,4" />

                    <ItemsControl ItemsSource="{Binding Bindings}" Margin="0,4,0,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:HotkeyBindingItemViewModel">
                                <Grid ColumnDefinitions="*,120,80"
                                      Margin="20,6,20,6"
                                      MinHeight="36">

                                    <TextBlock Grid.Column="0"
                                               Text="{Binding ActionLabel}"
                                               Foreground="{StaticResource TextBrushPrimary}"
                                               FontSize="13"
                                               VerticalAlignment="Center" />

                                    <Border Grid.Column="1"
                                            IsVisible="{Binding IsNotRebinding}"
                                            Background="{StaticResource MainBackgroundBrush}"
                                            BorderBrush="{StaticResource BoxBorderDefault}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="10,4"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding KeyDisplayName}"
                                                   Foreground="{StaticResource TextBrushSecondary}"
                                                   FontSize="12"
                                                   FontFamily="Cascadia Mono, Consolas, monospace" />
                                    </Border>

                                    <TextBlock Grid.Column="1"
                                               IsVisible="{Binding IsRebinding}"
                                               Text="Press any key…"
                                               Foreground="{StaticResource TextBrushDisabled}"
                                               FontSize="12"
                                               FontStyle="Italic"
                                               VerticalAlignment="Center" />

                                    <Button Grid.Column="2"
                                            IsVisible="{Binding IsNotRebinding}"
                                            Command="{Binding StartRebindCommand}"
                                            Content="Change"
                                            Background="Transparent"
                                            Foreground="{StaticResource TextBrushDisabled}"
                                            BorderBrush="{StaticResource BoxBorderDefault}"
                                            BorderThickness="1"
                                            Padding="10,5"
                                            CornerRadius="4"
                                            FontSize="12"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            ToolTip.Tip="Click then press a new key to reassign" />

                                    <Button Grid.Column="2"
                                            IsVisible="{Binding IsRebinding}"
                                            Command="{Binding CancelRebindCommand}"
                                            Content="Cancel"
                                            Background="Transparent"
                                            Foreground="#665544"
                                            BorderBrush="#3A2A1A"
                                            BorderThickness="1"
                                            Padding="10,5"
                                            CornerRadius="4"
                                            FontSize="12"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            ToolTip.Tip="Cancel key reassignment" />

                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </Border>

            <TextBlock Foreground="{StaticResource TextBrushDisabled}"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Text="Changes take effect immediately. Hotkeys are suppressed while typing in text fields." />

        </StackPanel>
    </ScrollViewer>

</UserControl>
