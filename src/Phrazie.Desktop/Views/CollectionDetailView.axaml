<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Phrazie.Desktop.ViewModels"
             xmlns:conv="using:Phrazie.Desktop.Converters"
             x:Class="Phrazie.Desktop.Views.CollectionDetailView"
             x:DataType="vm:CollectionDetailViewModel"
             Background="Transparent">

    <UserControl.Resources>
        <conv:HexToBrushConverter x:Key="HexToBrush" />
    </UserControl.Resources>

    <Panel>

        <Grid RowDefinitions="Auto,Auto,*" Margin="32,24,32,32">

            <Button Grid.Row="0"
                    Command="{Binding GoBackCommand}"
                    Content="← Back"
                    Background="Transparent"
                    Foreground="{StaticResource TextBrushSecondary}"
                    BorderThickness="0" Padding="0,0,0,16" FontSize="13"
                    HorizontalAlignment="Left"
                    ToolTip.Tip="Return to collections" />

            <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,28">

                <Button Grid.Column="0"
                        Command="{Binding PickCoverImageDirectCommand}"
                        Padding="0" BorderThickness="0" Background="Transparent"
                        Cursor="Hand" Margin="0,0,24,0"
                        ToolTip.Tip="Click to change cover image">
                    <Border Width="110" Height="110" CornerRadius="10" ClipToBounds="True">
                        <Panel>
                            <Border>
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                        <GradientStop Color="{StaticResource SurfaceDark}" Offset="0" />
                                        <GradientStop Color="{StaticResource SurfaceBlack}" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <TextBlock Text="P"
                                       IsVisible="{Binding CoverImage, Converter={x:Static ObjectConverters.IsNull}}"
                                       Foreground="{StaticResource TextBrushDisabled}"
                                       FontSize="72" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image Source="{Binding CoverImage}"
                                   Stretch="UniformToFill"
                                   IsVisible="{Binding CoverImage, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            <Border Background="#88000000" CornerRadius="10">
                                <Border.Styles>
                                    <Style Selector="Border">
                                        <Setter Property="Opacity" Value="0" />
                                    </Style>
                                    <Style Selector="Button:pointerover Border">
                                        <Setter Property="Opacity" Value="1" />
                                    </Style>
                                </Border.Styles>
                                <TextBlock Text="📷"
                                           FontSize="28"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                        </Panel>
                    </Border>
                </Button>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">

                    <Button Command="{Binding StartEditNameCommand}"
                            Background="Transparent" BorderThickness="0" Padding="0"
                            Cursor="IBeam" HorizontalAlignment="Left"
                            IsVisible="{Binding !IsEditingName}"
                            ToolTip.Tip="Click to rename">
                        <TextBlock Text="{Binding CollectionName}"
                                   Foreground="{StaticResource TextBrushPrimary}"
                                   FontSize="30" FontWeight="Light" />
                    </Button>

                    <TextBox x:Name="NameTextBox"
                             Text="{Binding EditName}"
                             IsVisible="{Binding IsEditingName}"
                             FontSize="30" FontWeight="Light" Foreground="Black"
                             Background="Transparent"
                             BorderThickness="0,0,0,1" BorderBrush="{StaticResource BoxBorderDefault}"
                             Padding="0,0,0,2" MaxWidth="480"
                             HorizontalAlignment="Left"
                             LostFocus="NameTextBox_LostFocus"
                             KeyDown="NameTextBox_KeyDown" />

                    <Button Command="{Binding StartEditDescriptionCommand}"
                            Background="Transparent" BorderThickness="0" Padding="0"
                            Cursor="IBeam" HorizontalAlignment="Left"
                            IsVisible="{Binding !IsEditingDescription}"
                            ToolTip.Tip="Click to edit description">
                        <Panel>
                            <TextBlock Text="{Binding CollectionDescription}"
                                       Foreground="{StaticResource TextBrushDisabled}"
                                       FontSize="13" FontStyle="Italic"
                                       TextWrapping="Wrap" MaxWidth="480"
                                       IsVisible="{Binding CollectionDescription, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            <TextBlock Text="Click to add a description…"
                                       Foreground="{StaticResource TextBrushDisabled}"
                                       FontSize="12" FontStyle="Italic"
                                       IsVisible="{Binding CollectionDescription, Converter={x:Static StringConverters.IsNullOrEmpty}}" />
                        </Panel>
                    </Button>

                    <TextBox x:Name="DescriptionTextBox"
                             Text="{Binding EditDescription}"
                             IsVisible="{Binding IsEditingDescription}"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             MaxWidth="480" HorizontalAlignment="Left"
                             FontSize="13" FontStyle="Italic" Foreground="Black"
                             Background="Transparent"
                             BorderThickness="0,0,0,1" BorderBrush="{StaticResource BoxBorderDefault}"
                             Padding="0,0,0,2"
                             LostFocus="DescriptionTextBox_LostFocus"
                             KeyDown="DescriptionTextBox_KeyDown" />

                </StackPanel>

                <Button Grid.Column="2"
                        Command="{Binding DeleteCollectionCommand}"
                        Background="Transparent" Foreground="#442222"
                        BorderThickness="0" Padding="6,4" FontSize="15"
                        VerticalAlignment="Top"
                        ToolTip.Tip="Delete collection">🗑</Button>

            </Grid>

            <ScrollViewer Grid.Row="2" DragDrop.AllowDrop="True">
                <StackPanel Spacing="0">

                    <ItemsControl ItemsSource="{Binding States}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:StateItemViewModel">

                                <Border Background="{StaticResource ControlBackgroundBrush}"
                                        BorderBrush="{StaticResource BoxBorderDefault}" BorderThickness="1"
                                        CornerRadius="8" Margin="0,0,0,10"
                                        ClipToBounds="True"
                                        DragDrop.AllowDrop="True">
                                    <Grid ColumnDefinitions="Auto,*,Auto">

                                        <Border Grid.Column="0"
                                                Width="18"
                                                VerticalAlignment="Stretch"
                                                Background="{Binding Color, Converter={StaticResource HexToBrush}}"
                                                Cursor="SizeAll"
                                                PointerPressed="DragHandle_PointerPressed"
                                                ToolTip.Tip="Drag to reorder">
                                            <Border.Styles>
                                                <Style Selector="Border:pointerover">
                                                    <Setter Property="Opacity" Value="0.65" />
                                                </Style>
                                            </Border.Styles>
                                        </Border>

                                        <StackPanel Grid.Column="1" Spacing="6" Margin="14,12,0,12">
                                            <TextBlock Text="{Binding Name}"
                                                       Margin="10,0,0,0"
                                                       Foreground="{StaticResource TextBrushSecondary}"
                                                       FontSize="11" FontWeight="Medium"
                                                       LetterSpacing="1" />

                                            <ScrollViewer Height="64"
                                                          HorizontalScrollBarVisibility="Auto"
                                                          VerticalScrollBarVisibility="Disabled">
                                                <StackPanel Orientation="Horizontal" Spacing="8">

                                                    <ItemsControl ItemsSource="{Binding AssignedClips}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Orientation="Horizontal" Spacing="8" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:ClipItemViewModel">
                                                                <Border Width="96" Height="64"
                                                                        CornerRadius="8"
                                                                        ClipToBounds="True"
                                                                        Background="{StaticResource MainBackgroundBrush}"
                                                                        BorderBrush="{StaticResource BoxBorderDefault}"
                                                                        BorderThickness="1"
                                                                        ToolTip.Tip="{Binding DisplayName}">
                                                                    <Panel>
                                                                        <Image Source="{Binding Thumbnail}"
                                                                               Stretch="UniformToFill"
                                                                               IsVisible="{Binding Thumbnail, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                                                        <StackPanel VerticalAlignment="Center"
                                                                                    HorizontalAlignment="Center"
                                                                                    Spacing="4"
                                                                                    IsVisible="{Binding Thumbnail, Converter={x:Static ObjectConverters.IsNull}}">
                                                                            <TextBlock Text="▶"
                                                                                       Foreground="{StaticResource TextBrushDisabled}"
                                                                                       FontSize="14"
                                                                                       HorizontalAlignment="Center" />
                                                                            <TextBlock Text="{Binding DisplayName}"
                                                                                       Foreground="{StaticResource TextBrushSecondary}"
                                                                                       FontSize="9"
                                                                                       HorizontalAlignment="Center"
                                                                                       MaxWidth="88"
                                                                                       TextTrimming="CharacterEllipsis" />
                                                                        </StackPanel>
                                                                        <Button Command="{Binding UnassignCommand}"
                                                                                Padding="0" BorderThickness="0"
                                                                                Background="Transparent"
                                                                                HorizontalAlignment="Stretch"
                                                                                VerticalAlignment="Stretch"
                                                                                ToolTip.Tip="Remove clip">
                                                                            <Button.Styles>
                                                                                <Style Selector="Button > Panel">
                                                                                    <Setter Property="Opacity" Value="0" />
                                                                                </Style>
                                                                                <Style Selector="Button:pointerover > Panel">
                                                                                    <Setter Property="Opacity" Value="1" />
                                                                                </Style>
                                                                            </Button.Styles>
                                                                            <Panel Background="#CC000000">
                                                                                <TextBlock Text="✕"
                                                                                           Foreground="#FF6666"
                                                                                           FontSize="16"
                                                                                           HorizontalAlignment="Center"
                                                                                           VerticalAlignment="Center" />
                                                                            </Panel>
                                                                        </Button>
                                                                    </Panel>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                    <Button Command="{Binding ImportClipsCommand}"
                                                            Padding="0" BorderThickness="0"
                                                            Background="Transparent"
                                                            ToolTip.Tip="Click to add clips — or drag &amp; drop video files here">
                                                        <Border Width="64" Height="64"
                                                                CornerRadius="8"
                                                                Background="{StaticResource MainBackgroundBrush}"
                                                                BorderBrush="{StaticResource BoxBorderDefault}"
                                                                BorderThickness="1">
                                                            <TextBlock Text="+"
                                                                       Foreground="{StaticResource TextBrushDisabled}"
                                                                       FontSize="24"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center" />
                                                        </Border>
                                                    </Button>

                                                </StackPanel>
                                            </ScrollViewer>

                                        </StackPanel>

                                        <StackPanel Grid.Column="2"
                                                    Spacing="6"
                                                    VerticalAlignment="Center"
                                                    Margin="12,0,14,0">
                                            <Button Command="{Binding ManageClipsCommand}"
                                                    Content="Manage"
                                                    Background="{StaticResource PanelBackgroundBrush}"
                                                    Foreground="{StaticResource TextBrushSecondary}"
                                                    BorderBrush="{StaticResource BoxBorderDefault}" BorderThickness="1"
                                                    Padding="14,6" CornerRadius="4" FontSize="11"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Center"
                                                    ToolTip.Tip="Open clip manager for this state" />
                                            <Button Command="{Binding RemoveCommand}"
                                                    Content="Remove"
                                                    Background="Transparent" Foreground="#663333"
                                                    BorderBrush="#2A1818" BorderThickness="1"
                                                    Padding="14,6" CornerRadius="4" FontSize="11"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Center"
                                                    ToolTip.Tip="Remove this state" />
                                        </StackPanel>

                                    </Grid>
                                </Border>

                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid IsVisible="{Binding !IsAddingState}" Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="1"
                                Command="{Binding ShowAddStateInputCommand}"
                                Content="+ State"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Background="{StaticResource ControlBackgroundBrush}"
                                Foreground="{StaticResource TextBrushSecondary}"
                                BorderBrush="{StaticResource BoxBorderDefault}" BorderThickness="1"
                                Padding="0,8" CornerRadius="4" FontSize="12"
                                ToolTip.Tip="Add a new state to this collection" />
                    </Grid>

                    <StackPanel IsVisible="{Binding IsAddingState}" Spacing="8" Margin="0,4,0,0">
                        <TextBox Text="{Binding NewStateName}"
                                 PlaceholderText="State name…"
                                 Width="220" HorizontalAlignment="Left"
                                 Background="{StaticResource ControlBackgroundBrush}"
                                 BorderBrush="{StaticResource BoxBorderDefault}"
                                 CornerRadius="4" FontSize="13"
                                 ToolTip.Tip="Enter a name for the new state" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button Command="{Binding AddStateCommand}"
                                    Content="Add"
                                    Background="#1E3A5F" Foreground="{StaticResource TextBrushPrimary}"
                                    BorderThickness="0" Padding="14,6" CornerRadius="4" FontSize="12"
                                    ToolTip.Tip="Confirm new state" />
                            <Button Command="{Binding CancelAddStateCommand}"
                                    Content="Cancel"
                                    Background="Transparent" Foreground="{StaticResource TextBrushDisabled}"
                                    BorderThickness="0" Padding="10,6" FontSize="12"
                                    ToolTip.Tip="Cancel adding a state" />
                        </StackPanel>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

        </Grid>

        <!-- State edit modal -->
        <Border IsVisible="{Binding IsStateEditOpen}" Background="#B3000000">
            <Border Background="{StaticResource ControlBackgroundBrush}"
                    BorderBrush="{StaticResource BoxBorderDefault}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Width="400"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="28,24">
                <StackPanel Spacing="20">

                    <TextBlock Text="Edit State"
                               Foreground="{StaticResource TextBrushPrimary}" FontSize="18" FontWeight="Light" />

                    <StackPanel Spacing="6">
                        <TextBlock Text="Name" Foreground="{StaticResource TextBrushSecondary}" FontSize="12" />
                        <TextBox Text="{Binding StateEditName}"
                                 Background="{StaticResource ControlBackgroundBrush}"
                                 BorderBrush="{StaticResource BoxBorderDefault}"
                                 CornerRadius="6" FontSize="14" Padding="12,8"
                                 ToolTip.Tip="State name" />
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock Text="Color" Foreground="{StaticResource TextBrushSecondary}" FontSize="12" />
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Border Width="28" Height="28" CornerRadius="6"
                                    Background="{Binding StateEditColor, Converter={StaticResource HexToBrush}}" />
                            <TextBlock Text="{Binding StateEditColor}"
                                       Foreground="{StaticResource TextBrushDisabled}" FontSize="12"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <ListBox ItemsSource="{x:Static vm:CollectionDetailViewModel.PresetColors}"
                                 SelectedItem="{Binding StateEditColor}"
                                 Background="Transparent" BorderThickness="0" Padding="0">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.Styles>
                                <Style Selector="ListBoxItem">
                                    <Setter Property="Padding" Value="4" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="CornerRadius" Value="20" />
                                </Style>
                                <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                    <Setter Property="Background" Value="Transparent" />
                                </Style>
                                <Style Selector="ListBoxItem:selected > Border">
                                    <Setter Property="BorderBrush" Value="{StaticResource TextBrushPrimary}" />
                                    <Setter Property="BorderThickness" Value="2" />
                                </Style>
                            </ListBox.Styles>
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Border Width="32" Height="32" CornerRadius="16"
                                            Background="{Binding Converter={StaticResource HexToBrush}}"
                                            Cursor="Hand" ToolTip.Tip="{Binding}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Command="{Binding SaveStateEditCommand}"
                                Content="Save"
                                Background="#1E3A5F" Foreground="{StaticResource TextBrushPrimary}"
                                BorderThickness="0" Padding="20,9" CornerRadius="6" FontSize="13"
                                ToolTip.Tip="Save state changes" />
                        <Button Command="{Binding CancelStateEditCommand}"
                                Content="Cancel"
                                Background="Transparent" Foreground="{StaticResource TextBrushDisabled}"
                                BorderThickness="0" Padding="14,9" FontSize="13"
                                ToolTip.Tip="Discard changes" />
                    </StackPanel>

                </StackPanel>
            </Border>
        </Border>

    </Panel>

</UserControl>
