<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Phrazie.Desktop.ViewModels"
             xmlns:conv="using:Phrazie.Desktop.Converters"
             x:Class="Phrazie.Desktop.Views.CollectionDetailView"
             x:DataType="vm:CollectionDetailViewModel"
             Background="Transparent">

    <UserControl.Resources>
        <conv:HexToBrushConverter x:Key="HexToBrush" />
    </UserControl.Resources>

    <Panel>

        <!-- ══════════════════════════════════════════════════════════════════
             PAGE CONTENT
        ══════════════════════════════════════════════════════════════════ -->
        <Grid RowDefinitions="Auto,Auto,*" Margin="32,24,32,32">

            <!-- ── Back button ── -->
            <Button Grid.Row="0"
                    Command="{Binding GoBackCommand}"
                    Content="← Back"
                    Background="Transparent" Foreground="#666677"
                    BorderThickness="0" Padding="0,0,0,16" FontSize="13"
                    HorizontalAlignment="Left"
                    ToolTip.Tip="Return to collections" />

            <!-- ── Collection header ── -->
            <Grid Grid.Row="1" ColumnDefinitions="Auto,*" Margin="0,0,0,28">

                <Border Grid.Column="0"
                        Width="110" Height="110"
                        CornerRadius="10"
                        ClipToBounds="True"
                        Margin="0,0,24,0">
                    <Panel>
                        <Border>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                    <GradientStop Color="#161630" Offset="0" />
                                    <GradientStop Color="#0A0A20" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <TextBlock Text="P"
                                   IsVisible="{Binding CoverImage, Converter={x:Static ObjectConverters.IsNull}}"
                                   Foreground="#252550" FontSize="72" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Image Source="{Binding CoverImage}"
                               Stretch="UniformToFill"
                               IsVisible="{Binding CoverImage, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    </Panel>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CollectionName}"
                                   Foreground="White" FontSize="30" FontWeight="Light" />
                        <Button Command="{Binding OpenEditModalCommand}"
                                Background="Transparent" Foreground="#555577"
                                BorderThickness="0" Padding="6,4" FontSize="15"
                                VerticalAlignment="Center"
                                ToolTip.Tip="Edit collection details">✏</Button>
                    </StackPanel>
                    <TextBlock Text="{Binding CollectionDescription}"
                               Foreground="#555577" FontSize="13" FontStyle="Italic"
                               TextWrapping="Wrap" MaxWidth="480"
                               IsVisible="{Binding CollectionDescription, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <TextBlock Text="No description — click ✏ to add one"
                               Foreground="#333344" FontSize="12" FontStyle="Italic"
                               IsVisible="{Binding CollectionDescription, Converter={x:Static StringConverters.IsNullOrEmpty}}" />
                </StackPanel>
            </Grid>

            <!-- ── States list ── -->
            <ScrollViewer Grid.Row="2" DragDrop.AllowDrop="True">
                <StackPanel Spacing="0">

                    <!-- State cards -->
                    <ItemsControl ItemsSource="{Binding States}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:StateItemViewModel">

                                <Border Background="#12121E"
                                        BorderBrush="#1E1E30" BorderThickness="1"
                                        CornerRadius="8" Margin="0,0,0,10"
                                        DragDrop.AllowDrop="True"
                                        ClipToBounds="True">
                                    <Grid ColumnDefinitions="4,Auto,*">

                                        <!-- Color accent bar -->
                                        <Border Grid.Column="0"
                                                Background="{Binding Color, Converter={StaticResource HexToBrush}}"
                                                CornerRadius="8,0,0,8" />

                                        <!-- Drag handle -->
                                        <Border Grid.Column="1"
                                                Padding="10,0,8,0"
                                                Cursor="SizeAll"
                                                VerticalAlignment="Stretch"
                                                PointerPressed="DragHandle_PointerPressed"
                                                ToolTip.Tip="Drag to reorder">
                                            <TextBlock Text="⠿"
                                                       Foreground="#2A2A50"
                                                       FontSize="15"
                                                       VerticalAlignment="Center" />
                                        </Border>

                                        <!-- Card content -->
                                        <StackPanel Grid.Column="2" Spacing="10"
                                                    Margin="0,14,16,14">

                                            <!-- Header: name + Edit + Remove -->
                                            <Grid ColumnDefinitions="*,Auto,Auto">

                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding Name}"
                                                           Foreground="White"
                                                           FontSize="15" FontWeight="Medium"
                                                           VerticalAlignment="Center" />

                                                <Button Grid.Column="1"
                                                        Command="{Binding OpenEditCommand}"
                                                        Content="Edit"
                                                        Background="#1A1A2E" Foreground="#AAAACC"
                                                        BorderBrush="#2A2A44" BorderThickness="1"
                                                        Padding="12,5" CornerRadius="4" FontSize="12"
                                                        Margin="0,0,8,0"
                                                        ToolTip.Tip="Edit state name and color" />

                                                <Button Grid.Column="2"
                                                        Command="{Binding RemoveCommand}"
                                                        Content="✕"
                                                        Background="Transparent" Foreground="#663333"
                                                        BorderBrush="#3A1A1A" BorderThickness="1"
                                                        Padding="8,5" CornerRadius="4" FontSize="12"
                                                        ToolTip.Tip="Remove this state" />
                                            </Grid>

                                            <!-- Horizontal clip placeholder row -->
                                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                                          VerticalScrollBarVisibility="Disabled">
                                                <ItemsControl ItemsSource="{Binding PlaceholderSlots}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal" Spacing="8" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Width="80" Height="60"
                                                                    CornerRadius="6"
                                                                    Background="#0E0E1C"
                                                                    BorderBrush="#1E1E30"
                                                                    BorderThickness="1">
                                                                <TextBlock Text="▶"
                                                                           Foreground="#2A2A44"
                                                                           FontSize="18"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center" />
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>

                                        </StackPanel>
                                    </Grid>
                                </Border>

                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- ── + State — always last ── -->
                    <Grid IsVisible="{Binding !IsAddingState}" Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="1"
                                Command="{Binding ShowAddStateInputCommand}"
                                Content="+ State"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Background="#1A1A2E" Foreground="#8888AA"
                                BorderBrush="#2A2A44" BorderThickness="1"
                                Padding="0,8" CornerRadius="4" FontSize="12"
                                ToolTip.Tip="Add a new state to this collection" />
                    </Grid>

                    <!-- Inline input mode -->
                    <StackPanel IsVisible="{Binding IsAddingState}"
                                Spacing="8" Margin="0,4,0,0">
                        <TextBox Text="{Binding NewStateName}"
                                 PlaceholderText="State name…"
                                 Width="220" HorizontalAlignment="Left"
                                 Background="#12121E" BorderBrush="#3A3A5A"
                                 CornerRadius="4" FontSize="13"
                                 ToolTip.Tip="Enter a name for the new state" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button Command="{Binding AddStateCommand}"
                                    Content="Add"
                                    Background="#1E3A5F" Foreground="White"
                                    BorderThickness="0" Padding="14,6" CornerRadius="4" FontSize="12"
                                    ToolTip.Tip="Confirm new state" />
                            <Button Command="{Binding CancelAddStateCommand}"
                                    Content="Cancel"
                                    Background="Transparent" Foreground="#555566"
                                    BorderThickness="0" Padding="10,6" FontSize="12"
                                    ToolTip.Tip="Cancel adding a state" />
                        </StackPanel>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

        </Grid>

        <!-- ══════════════════════════════════════════════════════════════════
             STATE EDIT MODAL
        ══════════════════════════════════════════════════════════════════ -->
        <Border IsVisible="{Binding IsStateEditOpen}"
                Background="#B3000000">
            <Border Background="#1A1A2E"
                    BorderBrush="#2A2A44"
                    BorderThickness="1"
                    CornerRadius="12"
                    Width="400"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="28,24">
                <StackPanel Spacing="20">

                    <TextBlock Text="Edit State"
                               Foreground="White" FontSize="18" FontWeight="Light" />

                    <!-- Name -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="Name" Foreground="#888899" FontSize="12" />
                        <TextBox Text="{Binding StateEditName}"
                                 Background="#12121E" BorderBrush="#3A3A5A"
                                 CornerRadius="6" FontSize="14" Padding="12,8"
                                 ToolTip.Tip="State name" />
                    </StackPanel>

                    <!-- Color picker -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="Color" Foreground="#888899" FontSize="12" />

                        <!-- Preview swatch -->
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Border Width="28" Height="28" CornerRadius="6"
                                    Background="{Binding StateEditColor, Converter={StaticResource HexToBrush}}" />
                            <TextBlock Text="{Binding StateEditColor}"
                                       Foreground="#555577" FontSize="12"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Preset swatches — ListBox handles selection automatically -->
                        <ListBox ItemsSource="{x:Static vm:CollectionDetailViewModel.PresetColors}"
                                 SelectedItem="{Binding StateEditColor}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="0">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.Styles>
                                <Style Selector="ListBoxItem">
                                    <Setter Property="Padding" Value="4" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="CornerRadius" Value="20" />
                                </Style>
                                <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                    <Setter Property="Background" Value="Transparent" />
                                </Style>
                                <Style Selector="ListBoxItem:selected > Border">
                                    <Setter Property="BorderBrush" Value="White" />
                                    <Setter Property="BorderThickness" Value="2" />
                                </Style>
                            </ListBox.Styles>
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Border Width="32" Height="32" CornerRadius="16"
                                            Background="{Binding Converter={StaticResource HexToBrush}}"
                                            Cursor="Hand"
                                            ToolTip.Tip="{Binding}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>

                    <!-- Save / Cancel -->
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Command="{Binding SaveStateEditCommand}"
                                Content="Save"
                                Background="#1E3A5F" Foreground="White"
                                BorderThickness="0" Padding="20,9" CornerRadius="6" FontSize="13"
                                ToolTip.Tip="Save state changes" />
                        <Button Command="{Binding CancelStateEditCommand}"
                                Content="Cancel"
                                Background="Transparent" Foreground="#555566"
                                BorderThickness="0" Padding="14,9" FontSize="13"
                                ToolTip.Tip="Discard changes" />
                    </StackPanel>

                </StackPanel>
            </Border>
        </Border>

        <!-- ══════════════════════════════════════════════════════════════════
             EDIT COLLECTION MODAL
        ══════════════════════════════════════════════════════════════════ -->
        <Border IsVisible="{Binding IsEditModalOpen}"
                Background="#B3000000">
            <Border Background="#1A1A2E"
                    BorderBrush="#2A2A44"
                    BorderThickness="1"
                    CornerRadius="12"
                    Width="460"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="28,24">
                <StackPanel Spacing="20">

                    <TextBlock Text="Edit Collection"
                               Foreground="White" FontSize="18" FontWeight="Light" />

                    <!-- Cover image row -->
                    <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                        <Border Width="72" Height="72" CornerRadius="8" ClipToBounds="True">
                            <Panel>
                                <Border>
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                            <GradientStop Color="#161630" Offset="0" />
                                            <GradientStop Color="#0A0A20" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <TextBlock Text="P"
                                           IsVisible="{Binding EditCoverPreview, Converter={x:Static ObjectConverters.IsNull}}"
                                           Foreground="#252550" FontSize="44" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Image Source="{Binding EditCoverPreview}"
                                       Stretch="UniformToFill"
                                       IsVisible="{Binding EditCoverPreview, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            </Panel>
                        </Border>
                        <StackPanel Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="Cover Image" Foreground="#888899" FontSize="12" />
                            <Button Command="{Binding PickEditCoverImageCommand}"
                                    Content="📷  Choose Image"
                                    Background="#1A1A30" Foreground="#AAAACC"
                                    BorderBrush="#2A2A44" BorderThickness="1"
                                    Padding="12,7" CornerRadius="6" FontSize="13"
                                    ToolTip.Tip="Select a cover image for this collection" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Name -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="Collection Name" Foreground="#888899" FontSize="12" />
                        <TextBox Text="{Binding EditName}"
                                 Background="#12121E" BorderBrush="#3A3A5A"
                                 CornerRadius="6" FontSize="14" Padding="12,8"
                                 ToolTip.Tip="Collection name" />
                    </StackPanel>

                    <!-- Description -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="Description" Foreground="#888899" FontSize="12" />
                        <TextBox Text="{Binding EditDescription}"
                                 Background="#12121E" BorderBrush="#3A3A5A"
                                 CornerRadius="6" FontSize="13" Padding="12,8"
                                 Height="80" AcceptsReturn="True" TextWrapping="Wrap"
                                 PlaceholderText="Describe the visual vibe of this collection…"
                                 ToolTip.Tip="Collection description" />
                    </StackPanel>

                    <!-- Save / Cancel -->
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Command="{Binding SaveEditCommand}"
                                Content="Save"
                                Background="#1E3A5F" Foreground="White"
                                BorderThickness="0" Padding="20,9" CornerRadius="6" FontSize="13"
                                ToolTip.Tip="Save changes" />
                        <Button Command="{Binding CancelEditCommand}"
                                Content="Cancel"
                                Background="Transparent" Foreground="#555566"
                                BorderThickness="0" Padding="14,9" FontSize="13"
                                ToolTip.Tip="Discard changes" />
                    </StackPanel>

                    <Border Height="1" Background="#1E1E30" />

                    <Button Command="{Binding DeleteCollectionCommand}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Background="Transparent" Foreground="#663333"
                            BorderBrush="#3A1A1A" BorderThickness="1"
                            Padding="14,9" CornerRadius="6" FontSize="13"
                            Content="🗑  Delete Collection"
                            ToolTip.Tip="Permanently delete this collection and all its states" />

                </StackPanel>
            </Border>
        </Border>

    </Panel>

</UserControl>
