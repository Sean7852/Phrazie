<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Phrazie.Desktop.ViewModels"
             xmlns:models="using:Phrazie.Core.Models"
             x:Class="Phrazie.Desktop.Views.CollectionDetailView"
             x:DataType="vm:CollectionDetailViewModel"
             Background="Transparent">

    <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="32">

        <!-- ── Back + Title ── -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Margin="0,0,0,24">
            <Button Grid.Column="0"
                    Command="{Binding GoBackCommand}"
                    Content="← Back"
                    Background="Transparent" Foreground="#888899"
                    BorderThickness="0" Padding="0,0,16,0" FontSize="14"
                    ToolTip.Tip="Return to collections" />

            <!-- Collection name — view mode -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10"
                        IsVisible="{Binding !IsRenamingCollection}"
                        VerticalAlignment="Center">
                <TextBlock Text="{Binding Model.Name}"
                           Foreground="White" FontSize="26" FontWeight="Light" />
                <Button Command="{Binding StartRenameCollectionCommand}"
                        Content="✏️"
                        Background="Transparent" Foreground="#666688"
                        BorderThickness="0" Padding="6,4" FontSize="14"
                        ToolTip.Tip="Rename this collection" />
            </StackPanel>

            <!-- Collection name — rename mode -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                        IsVisible="{Binding IsRenamingCollection}"
                        VerticalAlignment="Center">
                <TextBox Text="{Binding CollectionRenameInput}"
                         Width="280" FontSize="16"
                         Background="#12121E" BorderBrush="#3A3A5A" CornerRadius="4"
                         ToolTip.Tip="Type the new collection name" />
                <Button Command="{Binding SaveCollectionRenameCommand}"
                        Content="Save"
                        Background="#1E3A5F" Foreground="White"
                        BorderThickness="0" Padding="14,6" CornerRadius="4" FontSize="13"
                        ToolTip.Tip="Save new collection name" />
                <Button Command="{Binding CancelCollectionRenameCommand}"
                        Content="Cancel"
                        Background="Transparent" Foreground="#555566"
                        BorderThickness="0" Padding="10,6" FontSize="13"
                        ToolTip.Tip="Discard rename" />
            </StackPanel>
        </Grid>

        <!-- ── Import Clips ── -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
            <Button Command="{Binding ImportClipsCommand}"
                    Content="⬆ Import Clips"
                    Background="#1A2A1A" Foreground="#66AA66"
                    BorderBrush="#2A4A2A" BorderThickness="1"
                    Padding="14,7" CornerRadius="4" FontSize="13"
                    ToolTip.Tip="Import local video files into the clip library" />
            <TextBlock IsVisible="{Binding HasImportedClips}"
                       Text="{Binding ImportedClipCount, StringFormat='{}{0} clip(s) imported'}"
                       Foreground="#448844" FontSize="12"
                       VerticalAlignment="Center" />
        </StackPanel>

        <!-- ── Add State ── -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,0,0,20">
            <TextBox Text="{Binding NewStateName}"
                     PlaceholderText="New state name…"
                     Width="240"
                     Background="#12121E" BorderBrush="#2A2A44" CornerRadius="4"
                     ToolTip.Tip="Enter a name for the new state" />
            <Button Command="{Binding AddStateCommand}"
                    Content="Add State"
                    Background="White" Foreground="#111111"
                    BorderThickness="0" Padding="16,8" CornerRadius="4" FontWeight="Medium"
                    ToolTip.Tip="Add a new state to this collection" />
        </StackPanel>

        <!-- ── States list ── -->
        <ScrollViewer Grid.Row="3">
            <ItemsControl ItemsSource="{Binding States}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:StateItemViewModel">
                        <Border Background="#12121E"
                                BorderBrush="#1E1E30" BorderThickness="1"
                                CornerRadius="8" Margin="0,0,0,12" Padding="16,14">
                            <StackPanel Spacing="12">

                                <!-- State header row -->
                                <Grid ColumnDefinitions="*,Auto,Auto">

                                    <!-- Name — view mode -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8"
                                                IsVisible="{Binding !IsRenaming}"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}"
                                                   Foreground="White" FontSize="15" FontWeight="Medium" />
                                        <Button Command="{Binding StartRenameCommand}"
                                                Content="✏️"
                                                Background="Transparent" Foreground="#666688"
                                                BorderThickness="0" Padding="4,2" FontSize="12"
                                                ToolTip.Tip="Rename this state" />
                                    </StackPanel>

                                    <!-- Name — rename mode -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8"
                                                IsVisible="{Binding IsRenaming}"
                                                VerticalAlignment="Center">
                                        <TextBox Text="{Binding RenameInput}"
                                                 Width="200" FontSize="14"
                                                 Background="#0E0E1E" BorderBrush="#3A3A5A" CornerRadius="4"
                                                 ToolTip.Tip="Type the new state name" />
                                        <Button Command="{Binding SaveRenameCommand}"
                                                Content="Save"
                                                Background="#1E3A5F" Foreground="White"
                                                BorderThickness="0" Padding="12,5" CornerRadius="4" FontSize="12"
                                                ToolTip.Tip="Save new state name" />
                                        <Button Command="{Binding CancelRenameCommand}"
                                                Content="Cancel"
                                                Background="Transparent" Foreground="#555566"
                                                BorderThickness="0" Padding="8,5" FontSize="12"
                                                ToolTip.Tip="Discard rename" />
                                    </StackPanel>

                                    <!-- Playback mode selector -->
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{x:Static vm:StateItemViewModel.AllPlaybackModes}"
                                              SelectedItem="{Binding PlaybackMode}"
                                              Margin="0,0,8,0"
                                              Background="#0E0E1E" BorderBrush="#2A2A44"
                                              Foreground="#AAAACC" FontSize="12"
                                              VerticalAlignment="Center"
                                              ToolTip.Tip="Clip playback mode for this state" />

                                    <!-- Remove button -->
                                    <Button Grid.Column="2"
                                            Command="{Binding RemoveCommand}"
                                            Content="Remove"
                                            Background="Transparent" Foreground="#663333"
                                            BorderBrush="#3A1A1A" BorderThickness="1"
                                            Padding="10,5" CornerRadius="4" FontSize="12"
                                            ToolTip.Tip="Remove this state from the collection" />
                                </Grid>

                                <!-- Assigned clips -->
                                <StackPanel Spacing="6">
                                    <TextBlock Text="CLIPS"
                                               Foreground="#444466" FontSize="10" LetterSpacing="2" />

                                    <ItemsControl ItemsSource="{Binding AssignedClips}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ClipItemViewModel">
                                                <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,4">
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding DisplayName}"
                                                               Foreground="#CCCCEE" FontSize="13"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Duration}"
                                                               Foreground="#666688" FontSize="12"
                                                               Margin="0,0,10,0"
                                                               VerticalAlignment="Center" />
                                                    <Button Grid.Column="2"
                                                            Command="{Binding UnassignCommand}"
                                                            Content="✕"
                                                            Background="Transparent" Foreground="#555566"
                                                            BorderThickness="0" Padding="4,2" FontSize="12"
                                                            ToolTip.Tip="Remove clip from this state" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Assign clip button / picker -->
                                    <Button Command="{Binding ToggleClipPickerCommand}"
                                            IsVisible="{Binding !IsClipPickerOpen}"
                                            Content="+ Assign Clip"
                                            Background="#1A1A2E" Foreground="#8888AA"
                                            BorderBrush="#2A2A44" BorderThickness="1"
                                            Padding="10,6" CornerRadius="4" FontSize="12"
                                            ToolTip.Tip="Assign a clip to this state" />

                                    <!-- Clip picker -->
                                    <StackPanel IsVisible="{Binding IsClipPickerOpen}" Spacing="6">
                                        <ComboBox ItemsSource="{Binding UnassignedClips}"
                                                  SelectedItem="{Binding ClipToAssign}"
                                                  PlaceholderText="Select a clip…"
                                                  HorizontalAlignment="Stretch"
                                                  Background="#0E0E1E" BorderBrush="#3A3A5A"
                                                  ToolTip.Tip="Choose a clip to assign">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="models:Clip">
                                                    <TextBlock Text="{Binding DisplayName}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Button Command="{Binding AssignClipCommand}"
                                                    Content="Assign"
                                                    Background="#1E3A5F" Foreground="White"
                                                    BorderThickness="0" Padding="14,6" CornerRadius="4" FontSize="12"
                                                    ToolTip.Tip="Assign selected clip to this state" />
                                            <Button Command="{Binding ToggleClipPickerCommand}"
                                                    Content="Cancel"
                                                    Background="Transparent" Foreground="#555566"
                                                    BorderThickness="0" Padding="10,6" FontSize="12"
                                                    ToolTip.Tip="Close clip picker" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>

                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

    </Grid>

</UserControl>
