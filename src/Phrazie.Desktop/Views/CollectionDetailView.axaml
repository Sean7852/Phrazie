<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Phrazie.Desktop.ViewModels"
             xmlns:models="using:Phrazie.Core.Models"
             x:Class="Phrazie.Desktop.Views.CollectionDetailView"
             x:DataType="vm:CollectionDetailViewModel"
             Background="Transparent">

    <Panel>

        <!-- ══════════════════════════════════════════════════════════════════
             PAGE CONTENT
        ══════════════════════════════════════════════════════════════════ -->
        <Grid RowDefinitions="Auto,Auto,*" Margin="32,24,32,32">

            <!-- ── Back button ── -->
            <Button Grid.Row="0"
                    Command="{Binding GoBackCommand}"
                    Content="← Back"
                    Background="Transparent" Foreground="#666677"
                    BorderThickness="0" Padding="0,0,0,16" FontSize="13"
                    HorizontalAlignment="Left"
                    ToolTip.Tip="Return to collections" />

            <!-- ── Collection header (cover + name + description) ── -->
            <Grid Grid.Row="1" ColumnDefinitions="Auto,*" Margin="0,0,0,28">

                <Border Grid.Column="0"
                        Width="110" Height="110"
                        CornerRadius="10"
                        ClipToBounds="True"
                        Margin="0,0,24,0">
                    <Panel>
                        <Border>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                    <GradientStop Color="#161630" Offset="0" />
                                    <GradientStop Color="#0A0A20" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <TextBlock Text="P"
                                   IsVisible="{Binding CoverImage, Converter={x:Static ObjectConverters.IsNull}}"
                                   Foreground="#252550" FontSize="72" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Image Source="{Binding CoverImage}"
                               Stretch="UniformToFill"
                               IsVisible="{Binding CoverImage, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    </Panel>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CollectionName}"
                                   Foreground="White" FontSize="30" FontWeight="Light" />
                        <Button Command="{Binding OpenEditModalCommand}"
                                Background="Transparent" Foreground="#555577"
                                BorderThickness="0" Padding="6,4" FontSize="15"
                                VerticalAlignment="Center"
                                ToolTip.Tip="Edit collection details">✏</Button>
                    </StackPanel>
                    <TextBlock Text="{Binding CollectionDescription}"
                               Foreground="#555577" FontSize="13" FontStyle="Italic"
                               TextWrapping="Wrap" MaxWidth="480"
                               IsVisible="{Binding CollectionDescription, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <TextBlock Text="No description — click ✏ to add one"
                               Foreground="#333344" FontSize="12" FontStyle="Italic"
                               IsVisible="{Binding CollectionDescription, Converter={x:Static StringConverters.IsNullOrEmpty}}" />
                </StackPanel>
            </Grid>

            <!-- ── States list + "+ State" at the bottom ── -->
            <ScrollViewer Grid.Row="2" DragDrop.AllowDrop="True">
                <StackPanel Spacing="0">

                    <!-- State cards (draggable) -->
                    <ItemsControl ItemsSource="{Binding States}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:StateItemViewModel">
                                <Border Background="#12121E"
                                        BorderBrush="#1E1E30" BorderThickness="1"
                                        CornerRadius="8" Margin="0,0,0,12" Padding="0,14,16,14"
                                        DragDrop.AllowDrop="True">
                                    <Grid ColumnDefinitions="Auto,*">

                                        <!-- Drag handle -->
                                        <Border Grid.Column="0"
                                                Padding="12,0,10,0"
                                                Cursor="SizeAll"
                                                VerticalAlignment="Stretch"
                                                PointerPressed="DragHandle_PointerPressed"
                                                ToolTip.Tip="Drag to reorder">
                                            <TextBlock Text="⠿"
                                                       Foreground="#2A2A50"
                                                       FontSize="15"
                                                       VerticalAlignment="Center" />
                                        </Border>

                                        <!-- State content -->
                                        <StackPanel Grid.Column="1" Spacing="12">

                                            <!-- State header row -->
                                            <Grid ColumnDefinitions="*,Auto,Auto">

                                                <!-- Name — view mode -->
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8"
                                                            IsVisible="{Binding !IsRenaming}"
                                                            VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}"
                                                               Foreground="White" FontSize="15" FontWeight="Medium" />
                                                    <Button Command="{Binding StartRenameCommand}"
                                                            Content="✏️"
                                                            Background="Transparent" Foreground="#666688"
                                                            BorderThickness="0" Padding="4,2" FontSize="12"
                                                            ToolTip.Tip="Rename this state" />
                                                </StackPanel>

                                                <!-- Name — rename mode -->
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8"
                                                            IsVisible="{Binding IsRenaming}"
                                                            VerticalAlignment="Center">
                                                    <TextBox Text="{Binding RenameInput}"
                                                             Width="200" FontSize="14"
                                                             Background="#0E0E1E" BorderBrush="#3A3A5A" CornerRadius="4"
                                                             ToolTip.Tip="Type the new state name" />
                                                    <Button Command="{Binding SaveRenameCommand}"
                                                            Content="Save"
                                                            Background="#1E3A5F" Foreground="White"
                                                            BorderThickness="0" Padding="12,5" CornerRadius="4" FontSize="12"
                                                            ToolTip.Tip="Save new state name" />
                                                    <Button Command="{Binding CancelRenameCommand}"
                                                            Content="Cancel"
                                                            Background="Transparent" Foreground="#555566"
                                                            BorderThickness="0" Padding="8,5" FontSize="12"
                                                            ToolTip.Tip="Discard rename" />
                                                </StackPanel>

                                                <!-- Playback mode -->
                                                <ComboBox Grid.Column="1"
                                                          ItemsSource="{x:Static vm:StateItemViewModel.AllPlaybackModes}"
                                                          SelectedItem="{Binding PlaybackMode}"
                                                          Margin="0,0,8,0"
                                                          Background="#0E0E1E" BorderBrush="#2A2A44"
                                                          Foreground="#AAAACC" FontSize="12"
                                                          VerticalAlignment="Center"
                                                          ToolTip.Tip="Clip playback mode for this state" />

                                                <!-- Remove -->
                                                <Button Grid.Column="2"
                                                        Command="{Binding RemoveCommand}"
                                                        Content="Remove"
                                                        Background="Transparent" Foreground="#663333"
                                                        BorderBrush="#3A1A1A" BorderThickness="1"
                                                        Padding="10,5" CornerRadius="4" FontSize="12"
                                                        ToolTip.Tip="Remove this state from the collection" />
                                            </Grid>

                                            <!-- Assigned clips -->
                                            <StackPanel Spacing="6">
                                                <TextBlock Text="CLIPS"
                                                           Foreground="#444466" FontSize="10" LetterSpacing="2" />

                                                <ItemsControl ItemsSource="{Binding AssignedClips}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:ClipItemViewModel">
                                                            <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,4">
                                                                <TextBlock Grid.Column="0"
                                                                           Text="{Binding DisplayName}"
                                                                           Foreground="#CCCCEE" FontSize="13"
                                                                           VerticalAlignment="Center" />
                                                                <TextBlock Grid.Column="1"
                                                                           Text="{Binding Duration}"
                                                                           Foreground="#666688" FontSize="12"
                                                                           Margin="0,0,10,0"
                                                                           VerticalAlignment="Center" />
                                                                <Button Grid.Column="2"
                                                                        Command="{Binding UnassignCommand}"
                                                                        Content="✕"
                                                                        Background="Transparent" Foreground="#555566"
                                                                        BorderThickness="0" Padding="4,2" FontSize="12"
                                                                        ToolTip.Tip="Remove clip from this state" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <!-- Assign clip -->
                                                <Button Command="{Binding ToggleClipPickerCommand}"
                                                        IsVisible="{Binding !IsClipPickerOpen}"
                                                        Content="+ Assign Clip"
                                                        Background="#1A1A2E" Foreground="#8888AA"
                                                        BorderBrush="#2A2A44" BorderThickness="1"
                                                        Padding="10,6" CornerRadius="4" FontSize="12"
                                                        ToolTip.Tip="Assign a clip to this state" />

                                                <StackPanel IsVisible="{Binding IsClipPickerOpen}" Spacing="6">
                                                    <ComboBox ItemsSource="{Binding UnassignedClips}"
                                                              SelectedItem="{Binding ClipToAssign}"
                                                              PlaceholderText="Select a clip…"
                                                              HorizontalAlignment="Stretch"
                                                              Background="#0E0E1E" BorderBrush="#3A3A5A"
                                                              ToolTip.Tip="Choose a clip to assign">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate x:DataType="models:Clip">
                                                                <TextBlock Text="{Binding DisplayName}" />
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <Button Command="{Binding AssignClipCommand}"
                                                                Content="Assign"
                                                                Background="#1E3A5F" Foreground="White"
                                                                BorderThickness="0" Padding="14,6" CornerRadius="4" FontSize="12"
                                                                ToolTip.Tip="Assign selected clip to this state" />
                                                        <Button Command="{Binding ToggleClipPickerCommand}"
                                                                Content="Cancel"
                                                                Background="Transparent" Foreground="#555566"
                                                                BorderThickness="0" Padding="10,6" FontSize="12"
                                                                ToolTip.Tip="Close clip picker" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </StackPanel>

                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- ── + State — always at the bottom ── -->
                    <!-- Button mode -->
                    <Button Command="{Binding ShowAddStateInputCommand}"
                            IsVisible="{Binding !IsAddingState}"
                            Content="+ State"
                            Background="#1A1A2E" Foreground="#8888AA"
                            BorderBrush="#2A2A44" BorderThickness="1"
                            Padding="10,6" CornerRadius="4" FontSize="12"
                            HorizontalAlignment="Left"
                            Margin="0,4,0,0"
                            ToolTip.Tip="Add a new state to this collection" />

                    <!-- Inline input mode -->
                    <StackPanel IsVisible="{Binding IsAddingState}"
                                Spacing="8" Margin="0,4,0,0">
                        <TextBox Text="{Binding NewStateName}"
                                 PlaceholderText="State name…"
                                 Width="220" HorizontalAlignment="Left"
                                 Background="#12121E" BorderBrush="#3A3A5A"
                                 CornerRadius="4" FontSize="13"
                                 ToolTip.Tip="Enter a name for the new state" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button Command="{Binding AddStateCommand}"
                                    Content="Add"
                                    Background="#1E3A5F" Foreground="White"
                                    BorderThickness="0" Padding="14,6" CornerRadius="4" FontSize="12"
                                    ToolTip.Tip="Confirm new state" />
                            <Button Command="{Binding CancelAddStateCommand}"
                                    Content="Cancel"
                                    Background="Transparent" Foreground="#555566"
                                    BorderThickness="0" Padding="10,6" FontSize="12"
                                    ToolTip.Tip="Cancel adding a state" />
                        </StackPanel>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

        </Grid>

        <!-- ══════════════════════════════════════════════════════════════════
             EDIT MODAL OVERLAY
        ══════════════════════════════════════════════════════════════════ -->
        <Border IsVisible="{Binding IsEditModalOpen}"
                Background="#B3000000">
            <Border Background="#1A1A2E"
                    BorderBrush="#2A2A44"
                    BorderThickness="1"
                    CornerRadius="12"
                    Width="460"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="28,24">
                <StackPanel Spacing="20">

                    <TextBlock Text="Edit Collection"
                               Foreground="White" FontSize="18" FontWeight="Light" />

                    <!-- Cover image row -->
                    <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                        <Border Width="72" Height="72" CornerRadius="8" ClipToBounds="True">
                            <Panel>
                                <Border>
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                            <GradientStop Color="#161630" Offset="0" />
                                            <GradientStop Color="#0A0A20" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <TextBlock Text="P"
                                           IsVisible="{Binding EditCoverPreview, Converter={x:Static ObjectConverters.IsNull}}"
                                           Foreground="#252550" FontSize="44" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Image Source="{Binding EditCoverPreview}"
                                       Stretch="UniformToFill"
                                       IsVisible="{Binding EditCoverPreview, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            </Panel>
                        </Border>
                        <StackPanel Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="Cover Image" Foreground="#888899" FontSize="12" />
                            <Button Command="{Binding PickEditCoverImageCommand}"
                                    Content="📷  Choose Image"
                                    Background="#1A1A30" Foreground="#AAAACC"
                                    BorderBrush="#2A2A44" BorderThickness="1"
                                    Padding="12,7" CornerRadius="6" FontSize="13"
                                    ToolTip.Tip="Select a cover image for this collection" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Name -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="Collection Name" Foreground="#888899" FontSize="12" />
                        <TextBox Text="{Binding EditName}"
                                 Background="#12121E" BorderBrush="#3A3A5A"
                                 CornerRadius="6" FontSize="14" Padding="12,8"
                                 ToolTip.Tip="Collection name" />
                    </StackPanel>

                    <!-- Description -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="Description" Foreground="#888899" FontSize="12" />
                        <TextBox Text="{Binding EditDescription}"
                                 Background="#12121E" BorderBrush="#3A3A5A"
                                 CornerRadius="6" FontSize="13" Padding="12,8"
                                 Height="80" AcceptsReturn="True" TextWrapping="Wrap"
                                 PlaceholderText="Describe the visual vibe of this collection…"
                                 ToolTip.Tip="Collection description" />
                    </StackPanel>

                    <!-- Save / Cancel -->
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Command="{Binding SaveEditCommand}"
                                Content="Save"
                                Background="#1E3A5F" Foreground="White"
                                BorderThickness="0" Padding="20,9" CornerRadius="6" FontSize="13"
                                ToolTip.Tip="Save changes" />
                        <Button Command="{Binding CancelEditCommand}"
                                Content="Cancel"
                                Background="Transparent" Foreground="#555566"
                                BorderThickness="0" Padding="14,9" FontSize="13"
                                ToolTip.Tip="Discard changes" />
                    </StackPanel>

                    <Border Height="1" Background="#1E1E30" />

                    <Button Command="{Binding DeleteCollectionCommand}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Background="Transparent" Foreground="#663333"
                            BorderBrush="#3A1A1A" BorderThickness="1"
                            Padding="14,9" CornerRadius="6" FontSize="13"
                            Content="🗑  Delete Collection"
                            ToolTip.Tip="Permanently delete this collection and all its states" />

                </StackPanel>
            </Border>
        </Border>

    </Panel>

</UserControl>
