<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Phrazie.Desktop.ViewModels"
             xmlns:views="using:Phrazie.Desktop.Views"
             x:Class="Phrazie.Desktop.Views.LivePerformanceView"
             x:DataType="vm:LivePerformanceViewModel"
             Background="#0A0A12">

    <UserControl.Styles>

        <Style Selector="Button.hdr">
            <Setter Property="Background"                 Value="Transparent" />
            <Setter Property="Foreground"                 Value="#666688" />
            <Setter Property="BorderBrush"                Value="#2A2A44" />
            <Setter Property="BorderThickness"            Value="1" />
            <Setter Property="CornerRadius"               Value="5" />
            <Setter Property="Padding"                    Value="14,5" />
            <Setter Property="FontSize"                   Value="12" />
            <Setter Property="VerticalAlignment"          Value="Center" />
        </Style>
        <Style Selector="Button.hdr:pointerover /template/ ContentPresenter">
            <Setter Property="Background"             Value="#1A1A2E" />
            <Setter Property="TextElement.Foreground" Value="#AAAACC" />
        </Style>

        <Style Selector="Button.hdr.primary">
            <Setter Property="Background"    Value="White" />
            <Setter Property="Foreground"    Value="#0A0A14" />
            <Setter Property="BorderBrush"   Value="White" />
            <Setter Property="FontWeight"    Value="SemiBold" />
        </Style>
        <Style Selector="Button.hdr.primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background"             Value="#DDDDEE" />
            <Setter Property="TextElement.Foreground" Value="#0A0A14" />
        </Style>

        <Style Selector="Button.clip-card">
            <Setter Property="Background"    Value="#12121E" />
            <Setter Property="Foreground"    Value="#888899" />
            <Setter Property="BorderBrush"   Value="#1E1E30" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius"  Value="6" />
            <Setter Property="Padding"       Value="12,8" />
            <Setter Property="MinWidth"      Value="100" />
            <Setter Property="FontSize"      Value="12" />
        </Style>
        <Style Selector="Button.clip-card.active /template/ ContentPresenter">
            <Setter Property="Background"             Value="#0E1E0E" />
            <Setter Property="TextElement.Foreground" Value="#66CC66" />
        </Style>
        <Style Selector="Button.clip-card.active">
            <Setter Property="BorderBrush" Value="#2A5A2A" />
        </Style>

    </UserControl.Styles>

    <Grid RowDefinitions="44,*">

        <!-- ── ROW 0: Header bar ─────────────────────────────────────────── -->
        <Border Grid.Row="0"
                Background="#0D0D1A"
                BorderBrush="#1E1E30"
                BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto"
                  Margin="20,0">

                <!-- Center: live status strip -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="20">

                    <!-- Playing indicator dot -->
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7"
                                 Fill="#44DD44"
                                 VerticalAlignment="Center" />
                        <TextBlock Text="{Binding StatusLabel}"
                                   Foreground="#888899"
                                   FontSize="11"
                                   LetterSpacing="1"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Separator -->
                    <Rectangle Width="1" Height="16" Fill="#2A2A44" />

                    <!-- BPM readout -->
                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                        <TextBlock Text="BPM"
                                   Foreground="#444466"
                                   FontSize="10"
                                   LetterSpacing="1"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Bpm, StringFormat=\{0:0\}}"
                                   Foreground="#AAAACC"
                                   FontSize="13"
                                   FontWeight="Medium"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Separator -->
                    <Rectangle Width="1" Height="16" Fill="#2A2A44" />

                    <!-- Collection name -->
                    <TextBlock Text="{Binding CollectionName}"
                               Foreground="#666688"
                               FontSize="12"
                               VerticalAlignment="Center" />

                </StackPanel>

                <!-- Right: action buttons -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Spacing="8">
                    <Button Classes="hdr" Content="Record" />
                    <Button Classes="hdr" Content="Live Effect" />
                    <Button Classes="hdr primary" Content="Done" />
                </StackPanel>

            </Grid>
        </Border>

        <!-- ── ROW 1: Main area ──────────────────────────────────────────── -->
        <Grid Grid.Row="1" ColumnDefinitions="*,340">

            <!-- LEFT: Video area (placeholder) -->
            <views:LiveVideoView Grid.Column="0" />

            <!-- RIGHT: Control panel -->
            <Border Grid.Column="1"
                    Background="#0A0A14"
                    BorderBrush="#1E1E30"
                    BorderThickness="1,0,0,0">
                <Grid RowDefinitions="140,*,120">

                    <!-- RIGHT-TOP: BPM + collection + level bars -->
                    <Border Grid.Row="0"
                            Background="#0D0D1A"
                            BorderBrush="#1E1E30"
                            BorderThickness="0,0,0,1"
                            Padding="20,16">
                        <Grid ColumnDefinitions="*,Auto">

                            <!-- BPM number + genre -->
                            <StackPanel Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Spacing="4">
                                <TextBlock Text="{Binding Bpm, StringFormat=\{0:0\}}"
                                           Foreground="White"
                                           FontSize="64"
                                           FontWeight="Light"
                                           LineHeight="64" />
                                <TextBlock Text="{Binding CollectionName}"
                                           Foreground="#555566"
                                           FontSize="12"
                                           LetterSpacing="1" />
                            </StackPanel>

                            <!-- Decorative level bars -->
                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Bottom"
                                        Spacing="5">
                                <Rectangle Width="8" Height="60" Fill="#FF4499" RadiusX="2" RadiusY="2" VerticalAlignment="Bottom" />
                                <Rectangle Width="8" Height="88" Fill="#CC44FF" RadiusX="2" RadiusY="2" VerticalAlignment="Bottom" />
                                <Rectangle Width="8" Height="48" Fill="#9955FF" RadiusX="2" RadiusY="2" VerticalAlignment="Bottom" />
                                <Rectangle Width="8" Height="74" Fill="#FFCC00" RadiusX="2" RadiusY="2" VerticalAlignment="Bottom" />
                                <Rectangle Width="8" Height="38" Fill="#FF8800" RadiusX="2" RadiusY="2" VerticalAlignment="Bottom" />
                            </StackPanel>

                        </Grid>
                    </Border>

                    <!-- RIGHT-MID: Clip info (placeholder) -->
                    <views:LiveClipInfoView Grid.Row="1" />

                    <!-- RIGHT-BOTTOM: Schedule controls (placeholder) -->
                    <views:LiveScheduleView Grid.Row="2" />

                </Grid>
            </Border>

        </Grid>

    </Grid>

</UserControl>
