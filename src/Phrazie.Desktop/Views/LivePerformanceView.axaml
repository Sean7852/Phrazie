<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Phrazie.Desktop.ViewModels"
             xmlns:models="using:Phrazie.Core.Models"
             x:Class="Phrazie.Desktop.Views.LivePerformanceView"
             x:DataType="vm:LivePerformanceViewModel"
             Background="Transparent">

    <Grid RowDefinitions="*,Auto" Margin="32">

        <!-- Main performance area -->
        <Grid Grid.Row="0" ColumnDefinitions="*,1,*">

            <!-- LEFT: Current state + countdown -->
            <StackPanel Grid.Column="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12">

                <TextBlock Text="NOW"
                           Foreground="#555566"
                           FontSize="11"
                           LetterSpacing="3"
                           HorizontalAlignment="Center"
                           ToolTip.Tip="The visual state currently playing" />

                <TextBlock Text="{Binding CurrentStateName}"
                           Foreground="White"
                           FontSize="48"
                           FontWeight="Light"
                           HorizontalAlignment="Center" />

                <Border Background="#1A1A2E"
                        BorderBrush="#2A2A44"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="16,8"
                        HorizontalAlignment="Center"
                        ToolTip.Tip="Time or bars remaining until the next state transition">
                    <TextBlock Text="{Binding CountdownDisplay}"
                               Foreground="#CCCCDD"
                               FontSize="20"
                               HorizontalAlignment="Center" />
                </Border>

                <TextBlock Text="{Binding TriggerStatus}"
                           Foreground="#555566"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           ToolTip.Tip="Current trigger state: Idle, Scheduled, Counting, Fired, or Cancelled" />
            </StackPanel>

            <!-- Divider -->
            <Border Grid.Column="1" Background="#1E1E30" />

            <!-- RIGHT: Next state + trigger controls -->
            <StackPanel Grid.Column="2"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="16"
                        Width="280">

                <TextBlock Text="NEXT"
                           Foreground="#555566"
                           FontSize="11"
                           LetterSpacing="3"
                           HorizontalAlignment="Center"
                           ToolTip.Tip="The visual state that will play after the trigger fires" />

                <TextBlock Text="{Binding NextStateName}"
                           Foreground="#AAAACC"
                           FontSize="32"
                           FontWeight="Light"
                           HorizontalAlignment="Center" />

                <!-- State picker -->
                <ComboBox ItemsSource="{Binding AvailableStates}"
                          SelectedItem="{Binding SelectedNextState}"
                          Background="#12121E"
                          Foreground="White"
                          BorderBrush="#2A2A44"
                          HorizontalAlignment="Stretch"
                          ToolTip.Tip="Choose which state to transition to next">
                    <ComboBox.ItemTemplate>
                        <DataTemplate DataType="models:State">
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <!-- Delay controls -->
                <Grid ColumnDefinitions="*,8,Auto">
                    <NumericUpDown Grid.Column="0"
                                   Value="{Binding DelayValue}"
                                   Minimum="0"
                                   Maximum="256"
                                   Increment="1"
                                   FormatString="0"
                                   Background="#12121E"
                                   BorderBrush="#2A2A44"
                                   ToolTip.Tip="Number of seconds or bars before the transition fires" />

                    <ComboBox Grid.Column="2"
                              ItemsSource="{Binding DelayTypes}"
                              SelectedItem="{Binding DelayType}"
                              Background="#12121E"
                              Foreground="White"
                              BorderBrush="#2A2A44"
                              Width="110"
                              ToolTip.Tip="Delay unit: Immediate, Seconds, or Bars (bars require BPM)" />
                </Grid>

                <!-- Schedule button -->
                <Button Command="{Binding ScheduleTriggerCommand}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Background="#1E3A5F"
                        Foreground="White"
                        BorderThickness="0"
                        Padding="0,12"
                        FontSize="14"
                        ToolTip.Tip="Schedule the transition — Phrazie will count down and switch at the right moment">
                    Schedule Trigger
                </Button>

                <!-- Cancel -->
                <Button Command="{Binding CancelTriggerCommand}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Background="Transparent"
                        Foreground="#666677"
                        BorderBrush="#2A2A44"
                        BorderThickness="1"
                        Padding="0,10"
                        FontSize="13"
                        ToolTip.Tip="Cancel the pending trigger without changing the current state">
                    Cancel
                </Button>
            </StackPanel>
        </Grid>

        <!-- BOTTOM: Emergency switch bar -->
        <Border Grid.Row="1"
                Background="#1A0000"
                BorderBrush="#5A0000"
                BorderThickness="0,1,0,0"
                Padding="32,16">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0"
                           Text="Emergency switch — transitions immediately to next state"
                           Foreground="#994444"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1"
                        Command="{Binding EmergencySwitchCommand}"
                        Content="SWITCH NOW"
                        Background="#7A0000"
                        Foreground="White"
                        BorderThickness="0"
                        Padding="24,10"
                        FontWeight="SemiBold"
                        ToolTip.Tip="Immediately jump to the next state — use when the crowd moment hits unexpectedly" />
            </Grid>
        </Border>

    </Grid>

</UserControl>
