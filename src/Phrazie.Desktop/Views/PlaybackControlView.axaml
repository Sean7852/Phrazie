<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Phrazie.Desktop.ViewModels"
             x:Class="Phrazie.Desktop.Views.PlaybackControlView"
             x:DataType="vm:LivePerformanceViewModel">

  <UserControl.Styles>

    <!-- ── Transport base ── -->
    <Style Selector="Button.transport">
      <Setter Property="Background"                 Value="Transparent" />
      <Setter Property="Foreground"                 Value="{StaticResource TextBrushSecondary}" />
      <Setter Property="BorderBrush"                Value="{StaticResource BoxBorderDefault}" />
      <Setter Property="BorderThickness"            Value="1" />
      <Setter Property="CornerRadius"               Value="6" />
      <Setter Property="Padding"                    Value="10,6" />
      <Setter Property="FontSize"                   Value="13" />
      <Setter Property="VerticalAlignment"          Value="Center" />
    </Style>
    <Style Selector="Button.transport:pointerover /template/ ContentPresenter">
      <Setter Property="Background"             Value="{StaticResource ControlBackgroundBrush}" />
      <Setter Property="TextElement.Foreground" Value="{StaticResource TextBrushPrimary}" />
    </Style>

    <!-- ── Play/Pause: amber fill, rounded rect ── -->
    <Style Selector="Button.transport.playpause">
      <Setter Property="Background"      Value="{StaticResource AccentBrush}" />
      <Setter Property="Foreground"      Value="#0A0A0B" />
      <Setter Property="BorderBrush"     Value="{StaticResource AccentBrush}" />
      <Setter Property="FontWeight"      Value="Bold" />
      <Setter Property="Width"           Value="52" />
      <Setter Property="Height"          Value="36" />
      <Setter Property="CornerRadius"    Value="8" />
      <Setter Property="Padding"         Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment"   Value="Center" />
    </Style>
    <Style Selector="Button.transport.playpause:pointerover /template/ ContentPresenter">
      <Setter Property="Background"             Value="#F7AB2E" />
      <Setter Property="TextElement.Foreground" Value="#0A0A0B" />
    </Style>

    <!-- ── Skip nav buttons ── -->
    <Style Selector="Button.transport.nav">
      <Setter Property="Width"                      Value="32" />
      <Setter Property="Height"                     Value="32" />
      <Setter Property="Padding"                    Value="0" />
      <Setter Property="CornerRadius"               Value="4" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment"   Value="Center" />
    </Style>

    <!-- ── BPM +/- step ── -->
    <Style Selector="Button.transport.bpmstep">
      <Setter Property="Width"        Value="28" />
      <Setter Property="Height"       Value="28" />
      <Setter Property="Padding"      Value="0" />
      <Setter Property="FontSize"     Value="16" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>

    <!-- ── TAP tempo ── -->
    <Style Selector="Button.transport.tap">
      <Setter Property="Foreground"   Value="{StaticResource AccentBrush}" />
      <Setter Property="BorderBrush"  Value="{StaticResource AccentBrush}" />
      <Setter Property="FontSize"     Value="11" />
      <Setter Property="FontWeight"   Value="Bold" />
      <Setter Property="LetterSpacing" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding"      Value="10,6" />
    </Style>
    <Style Selector="Button.transport.tap:pointerover /template/ ContentPresenter">
      <Setter Property="Background"             Value="#1AF59E0B" />
      <Setter Property="TextElement.Foreground" Value="{StaticResource AccentBrush}" />
    </Style>

    <!-- ── REC button ── -->
    <Style Selector="Button.transport.rec">
      <Setter Property="Foreground"   Value="{StaticResource TextBrushSecondary}" />
      <Setter Property="BorderBrush"  Value="{StaticResource BoxBorderDefault}" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding"      Value="12,6" />
      <Setter Property="FontSize"     Value="12" />
      <Setter Property="FontWeight"   Value="SemiBold" />
    </Style>
    <Style Selector="Button.transport.rec.active /template/ ContentPresenter">
      <Setter Property="Background"             Value="#1AEF4444" />
    </Style>
    <Style Selector="Button.transport.rec.active">
      <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
      <Setter Property="Foreground"  Value="{StaticResource DangerBrush}" />
    </Style>

    <!-- ── PROJECT button ── -->
    <Style Selector="Button.transport.project">
      <Setter Property="Foreground"   Value="{StaticResource TextBrushSecondary}" />
      <Setter Property="BorderBrush"  Value="{StaticResource BoxBorderDefault}" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding"      Value="12,6" />
      <Setter Property="FontSize"     Value="12" />
      <Setter Property="FontWeight"   Value="SemiBold" />
    </Style>
    <Style Selector="Button.transport.project.active /template/ ContentPresenter">
      <Setter Property="Background"             Value="#1AF59E0B" />
    </Style>
    <Style Selector="Button.transport.project.active">
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
      <Setter Property="Foreground"  Value="{StaticResource AccentBrush}" />
    </Style>

    <!-- ── Mode picker trigger button ── -->
    <Style Selector="Button.modepicker">
      <Setter Property="Background"     Value="Transparent" />
      <Setter Property="Foreground"     Value="{StaticResource TextBrushSecondary}" />
      <Setter Property="BorderBrush"    Value="{StaticResource BoxBorderDefault}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius"   Value="4" />
      <Setter Property="Width"          Value="26" />
      <Setter Property="Height"         Value="26" />
      <Setter Property="Padding"        Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment"   Value="Center" />
      <Setter Property="VerticalAlignment"          Value="Center" />
    </Style>
    <Style Selector="Button.modepicker:pointerover /template/ ContentPresenter">
      <Setter Property="Background"             Value="{StaticResource ControlBackgroundBrush}" />
      <Setter Property="TextElement.Foreground" Value="{StaticResource TextBrushPrimary}" />
    </Style>

    <!-- ── Mode picker popup icon buttons ── -->
    <Style Selector="Button.modeicon">
      <Setter Property="Background"     Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Width"          Value="48" />
      <Setter Property="Height"         Value="48" />
      <Setter Property="Padding"        Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment"   Value="Center" />
      <Setter Property="CornerRadius"   Value="6" />
    </Style>
    <Style Selector="Button.modeicon:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource ControlBackgroundBrush}" />
    </Style>

  </UserControl.Styles>

  <Grid Height="100" VerticalAlignment="Bottom" Background="Transparent">

    <!-- Footer bar -->
    <Border Height="64"
            VerticalAlignment="Bottom"
            Background="{StaticResource PanelBackgroundBrush}"
            BorderBrush="{StaticResource BoxBorderDefault}"
            BorderThickness="0,1,0,0" />

    <Grid ColumnDefinitions="Auto,*,Auto" Margin="20,0">

      <!-- ── Transport controls ── -->
      <StackPanel Grid.Column="0"
                  Orientation="Horizontal"
                  VerticalAlignment="Bottom"
                  Height="64"
                  Spacing="6">
        <Button Classes="transport nav" Content="◄" />
        <Button Classes="transport playpause"
                Command="{Binding TogglePlayCommand}">
          <TextBlock Text="{Binding PlayPauseIcon}"
                     FontFamily="Segoe UI Symbol,Segoe MDL2 Assets"
                     FontSize="13"
                     FontWeight="Regular"
                     Width="18"
                     TextAlignment="Center"
                     VerticalAlignment="Center" />
        </Button>
        <Button Classes="transport nav" Content="►" />
      </StackPanel>

      <!-- ── BPM panel ── -->
      <Border Grid.Column="1"
              Width="440"
              Height="80"
              VerticalAlignment="Bottom"
              Background="{StaticResource PanelBackgroundBrush}"
              BorderBrush="{StaticResource BoxBorderDefault}"
              BorderThickness="1,1,1,0"
              CornerRadius="8,8,0,0"
              Padding="20,8"
              ZIndex="10">

        <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
          <TextBlock Grid.Column="0"
                     Text="BPM"
                     Foreground="{StaticResource TextBrushSecondary}"
                     FontSize="10"
                     FontWeight="Bold"
                     LetterSpacing="2"
                     VerticalAlignment="Center"
                     Margin="0,0,12,0" />

          <Button Grid.Column="1"
                  Classes="transport bpmstep"
                  Content="−"
                  Command="{Binding DecreaseBpmCommand}" />

          <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="12,0">
            <TextBlock Text="{Binding Bpm, StringFormat=\{0:0\}}"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="{StaticResource TextBrushPrimary}"
                       HorizontalAlignment="Center" />
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,0">
              <TextBlock Grid.Column="0"
                         Text="60"
                         FontSize="9"
                         Foreground="{StaticResource TextBrushDisabled}"
                         Margin="0,0,6,0" />
              <Slider Grid.Column="1"
                      Classes="bpm"
                      Minimum="60"
                      Maximum="200"
                      Value="{Binding Bpm}"
                      Height="40" />
              <TextBlock Grid.Column="2"
                         Text="200"
                         FontSize="9"
                         Foreground="{StaticResource TextBrushDisabled}"
                         Margin="6,0,0,0" />
            </Grid>
          </StackPanel>

          <Button Grid.Column="3"
                  Classes="transport bpmstep"
                  Content="+"
                  Command="{Binding IncreaseBpmCommand}" />

          <Button Grid.Column="4"
                  Classes="transport tap"
                  Content="TAP"
                  Margin="12,0,0,0" />
        </Grid>
      </Border>

      <!-- ── REC + timecode ── -->
      <StackPanel Grid.Column="2"
                  Orientation="Horizontal"
                  VerticalAlignment="Bottom"
                  Height="64"
                  Spacing="12">

        <!-- ── Mode picker trigger + popup ── -->
        <Panel x:Name="ModePickerAnchor" VerticalAlignment="Center">
          <Button Classes="modepicker"
                  Command="{Binding ToggleProjectionPickerCommand}"
                  ToolTip.Tip="Output mode">
            <!-- 2×2 grid icon -->
            <Viewbox Width="12" Height="12">
              <Canvas Width="12" Height="12">
                <Path Data="M 0,0 H 5 V 5 H 0 Z M 7,0 H 12 V 5 H 7 Z M 0,7 H 5 V 12 H 0 Z M 7,7 H 12 V 12 H 7 Z"
                      Stroke="#8E8E93" StrokeThickness="1" Fill="Transparent" />
              </Canvas>
            </Viewbox>
          </Button>

          <Popup IsOpen="{Binding IsProjectionPickerOpen, Mode=TwoWay}"
                 Placement="TopEdgeAlignedLeft"
                 IsLightDismissEnabled="True"
                 VerticalOffset="-8">
            <Border Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource BoxBorderDefault}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="6">
              <StackPanel Orientation="Horizontal" Spacing="2">

                <!-- External fullscreen: two rects, right one has expand corners -->
                <Button Classes="modeicon"
                        Command="{Binding ProjectExtFullscreenCommand}"
                        ToolTip.Tip="Fullscreen — external screen">
                  <Viewbox Width="26" Height="18">
                    <Canvas Width="22" Height="13">
                      <Path Data="M 0,1.5 H 6.5 V 11 H 0 Z
                                  M 8.5,0 H 21.5 V 12.5 H 8.5 Z
                                  M 9.5,1 V 2.5 M 9.5,1 H 11
                                  M 20.5,1 H 19 M 20.5,1 V 2.5
                                  M 9.5,11.5 V 10 M 9.5,11.5 H 11
                                  M 20.5,11.5 H 19 M 20.5,11.5 V 10"
                            Stroke="#8E8E93" StrokeThickness="1" Fill="Transparent" />
                    </Canvas>
                  </Viewbox>
                </Button>

                <!-- External windowed: two rects, small inner window in right -->
                <Button Classes="modeicon"
                        Command="{Binding ProjectExtWindowedCommand}"
                        ToolTip.Tip="Windowed — external screen">
                  <Viewbox Width="26" Height="18">
                    <Canvas Width="22" Height="13">
                      <Path Data="M 0,1.5 H 6.5 V 11 H 0 Z
                                  M 8.5,0 H 21.5 V 12.5 H 8.5 Z
                                  M 11,3 H 19 V 9.5 H 11 Z"
                            Stroke="#8E8E93" StrokeThickness="1" Fill="Transparent" />
                    </Canvas>
                  </Viewbox>
                </Button>

                <Border Width="1" Background="{StaticResource BoxBorderDefault}" Margin="2,6" />

                <!-- Main fullscreen: single large rect with expand corners -->
                <Button Classes="modeicon"
                        Command="{Binding ProjectMainFullscreenCommand}"
                        ToolTip.Tip="Fullscreen — main screen">
                  <Viewbox Width="26" Height="18">
                    <Canvas Width="22" Height="13">
                      <Path Data="M 0,0 H 21.5 V 12.5 H 0 Z
                                  M 1,1 V 3 M 1,1 H 3
                                  M 20.5,1 H 18.5 M 20.5,1 V 3
                                  M 1,11.5 V 9.5 M 1,11.5 H 3
                                  M 20.5,11.5 H 18.5 M 20.5,11.5 V 9.5"
                            Stroke="#8E8E93" StrokeThickness="1" Fill="Transparent" />
                    </Canvas>
                  </Viewbox>
                </Button>

                <!-- Main windowed: single rect with smaller inner rect -->
                <Button Classes="modeicon"
                        Command="{Binding ProjectMainWindowedCommand}"
                        ToolTip.Tip="Windowed — main screen">
                  <Viewbox Width="26" Height="18">
                    <Canvas Width="22" Height="13">
                      <Path Data="M 0,0 H 21.5 V 12.5 H 0 Z
                                  M 4,3 H 17.5 V 9.5 H 4 Z"
                            Stroke="#8E8E93" StrokeThickness="1" Fill="Transparent" />
                    </Canvas>
                  </Viewbox>
                </Button>

              </StackPanel>
            </Border>
          </Popup>
        </Panel>

        <Panel VerticalAlignment="Center">
          <Border CornerRadius="5"
                  Margin="-4"
                  IsVisible="{Binding IsProjecting}"
                  BoxShadow="0 0 14 4 #80F59E0B" />
          <Button Classes="transport project"
                  Classes.active="{Binding IsProjecting}"
                  Command="{Binding ToggleProjectionCommand}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="⬛" FontSize="9" VerticalAlignment="Center" />
              <TextBlock Text="PROJECT" FontWeight="Bold" />
            </StackPanel>
          </Button>
        </Panel>

        <Panel VerticalAlignment="Center">
          <Border CornerRadius="5"
                  Margin="-4"
                  IsVisible="{Binding IsRecording}"
                  BoxShadow="0 0 14 4 #80EF4444" />
          <Button Classes="transport rec"
                  Classes.active="{Binding IsRecording}"
                  Command="{Binding ToggleRecordCommand}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Ellipse Width="8" Height="8" Fill="{StaticResource DangerBrush}" />
              <TextBlock Text="REC" FontWeight="Bold" />
            </StackPanel>
          </Button>
        </Panel>

        <Border Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource BoxBorderDefault}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="12,8"
                VerticalAlignment="Center">
          <StackPanel Spacing="2">
            <TextBlock Text="00:00:00"
                       FontFamily="Consolas"
                       FontSize="15"
                       FontWeight="Bold"
                       Foreground="{StaticResource TextBrushPrimary}" />
            <TextBlock Text="1080p60 · 0.0 MB"
                       FontSize="9"
                       Foreground="{StaticResource TextBrushSecondary}" />
          </StackPanel>
        </Border>
      </StackPanel>

    </Grid>
  </Grid>
</UserControl>
