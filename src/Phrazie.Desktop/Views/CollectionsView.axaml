<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Phrazie.Desktop.ViewModels"
             x:Class="Phrazie.Desktop.Views.CollectionsView"
             x:DataType="vm:CollectionsViewModel"
             Background="Transparent">

    <UserControl.Styles>
        <Style Selector="Button.select-btn">
            <Setter Property="Width"            Value="34" />
            <Setter Property="Height"           Value="34" />
            <Setter Property="Padding"          Value="0" />
            <Setter Property="CornerRadius"     Value="17" />
            <Setter Property="BorderThickness"  Value="0" />
            <Setter Property="Background"       Value="{StaticResource BoxBorderDefault}" />
        </Style>
        <Style Selector="Button.select-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        </Style>
        <!-- Active collection: filled amber -->
        <Style Selector="Button.select-btn.active">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        </Style>
        <Style Selector="Button.select-btn.active:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#FFBB44" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*" Margin="32">

        <StackPanel Grid.Row="0" Margin="0,0,0,28">
            <TextBlock Text="Collections"
                       Foreground="{StaticResource TextBrushPrimary}"
                       FontSize="28"
                       FontWeight="Light"
                       Margin="0,0,0,16" />

            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox Text="{Binding NewCollectionName}"
                         PlaceholderText="New collection name…"
                         Width="280"
                         Background="{StaticResource ControlBackgroundBrush}"
                         BorderBrush="{StaticResource BoxBorderDefault}"
                         CornerRadius="4"
                         ToolTip.Tip="Enter a name for your new collection" />
                <Button Command="{Binding CreateCollectionCommand}"
                        Content="Create"
                        Background="{StaticResource TextBrushPrimary}"
                        Foreground="{StaticResource MainBackgroundBrush}"
                        BorderThickness="0"
                        Padding="18,8"
                        CornerRadius="4"
                        FontWeight="Medium"
                        ToolTip.Tip="Create a new collection with Normal, Break, and Drop states" />
            </StackPanel>
        </StackPanel>

        <ItemsControl Grid.Row="1" ItemsSource="{Binding Collections}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:CollectionCardViewModel">
                    <Border Width="185"
                            Background="{StaticResource ControlBackgroundBrush}"
                            BorderBrush="{StaticResource BoxBorderDefault}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Margin="0,0,14,14"
                            ClipToBounds="True"
                            Cursor="Hand">
                        <StackPanel>

                            <Panel Height="115">
                                <Border>
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                            <GradientStop Color="{StaticResource SurfaceBlack}" Offset="0" />
                                            <GradientStop Color="{StaticResource SurfaceDark}" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <Image Source="{Binding CoverImage}"
                                       Stretch="UniformToFill"
                                       IsVisible="{Binding CoverImage, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            </Panel>

                            <StackPanel Margin="14,12,14,14" Spacing="10">
                                <TextBlock Text="{Binding Name}"
                                           Foreground="{StaticResource TextBrushPrimary}"
                                           FontSize="14"
                                           FontWeight="Medium" />

                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button Classes="select-btn"
                                            Classes.active="{Binding IsActive}"
                                            Command="{Binding SelectCommand}"
                                            ToolTip.Tip="Set as the active collection for live performance">
                                        <TextBlock Text="▶"
                                                   FontFamily="Segoe UI Symbol"
                                                   FontSize="13"
                                                   Foreground="{StaticResource TextBrushPrimary}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Margin="3,0,0,0" />
                                    </Button>
                                    <Button Command="{Binding ManageCommand}"
                                            Content="Manage"
                                            Background="Transparent"
                                            Foreground="{StaticResource TextBrushSecondary}"
                                            BorderThickness="0"
                                            Padding="8,5"
                                            FontSize="12"
                                            ToolTip.Tip="Open collection management" />
                                </StackPanel>
                            </StackPanel>

                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

    </Grid>

</UserControl>
