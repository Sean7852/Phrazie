<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Phrazie.Desktop.ViewModels"
             x:Class="Phrazie.Desktop.Views.CollectionsView"
             x:DataType="vm:CollectionsViewModel"
             Background="Transparent">

    <Grid RowDefinitions="Auto,*" Margin="32">

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,28">
            <TextBlock Text="Collections"
                       Foreground="White"
                       FontSize="28"
                       FontWeight="Light"
                       Margin="0,0,0,16" />

            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox Text="{Binding NewCollectionName}"
                         PlaceholderText="New collection name…"
                         Width="280"
                         Background="#12121E"
                         BorderBrush="#2A2A44"
                         CornerRadius="4"
                         ToolTip.Tip="Enter a name for your new collection" />
                <Button Command="{Binding CreateCollectionCommand}"
                        Content="Create"
                        Background="White"
                        Foreground="#111111"
                        BorderThickness="0"
                        Padding="18,8"
                        CornerRadius="4"
                        FontWeight="Medium"
                        ToolTip.Tip="Create a new collection with Normal, Break, and Drop states" />
            </StackPanel>
        </StackPanel>

        <!-- Collection cards -->
        <ItemsControl Grid.Row="1" ItemsSource="{Binding Collections}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:CollectionCardViewModel">
                    <Border Width="185"
                            Background="#12121E"
                            BorderBrush="#1E1E30"
                            BorderThickness="1"
                            CornerRadius="8"
                            Margin="0,0,14,14"
                            ClipToBounds="True"
                            Cursor="Hand">
                        <StackPanel>

                            <!-- Thumbnail -->
                            <Panel Height="115">
                                <Border>
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                            <GradientStop Color="#0F0F22" Offset="0" />
                                            <GradientStop Color="#1A1A3A" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <Image Source="{Binding CoverImage}"
                                       Stretch="UniformToFill"
                                       IsVisible="{Binding CoverImage, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            </Panel>

                            <!-- Name + buttons -->
                            <StackPanel Margin="14,12,14,14" Spacing="10">
                                <TextBlock Text="{Binding Name}"
                                           Foreground="White" FontSize="14" FontWeight="Medium" />

                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Command="{Binding SelectCommand}"
                                            Content="Select"
                                            Background="#2A2A44" Foreground="White"
                                            BorderThickness="0" Padding="12,5" CornerRadius="4"
                                            FontSize="12"
                                            ToolTip.Tip="Set as the active collection for live performance" />
                                    <Button Command="{Binding ManageCommand}"
                                            Content="Manage"
                                            Background="Transparent" Foreground="#666688"
                                            BorderThickness="0" Padding="8,5"
                                            FontSize="12"
                                            ToolTip.Tip="Open collection management" />
                                </StackPanel>
                            </StackPanel>

                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

    </Grid>

</UserControl>
